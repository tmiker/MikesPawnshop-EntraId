@page "/products/productsList"
@rendermode InteractiveServer
@inject IProductsWriteHttpService _writeSideHttpClient
@inject NavigationManager Nav
@implements IDisposable

@attribute [Authorize(Policy = "IsAdminOrManager")]

<PageTitle>Manage Products</PageTitle>

<div class="row mt-2">
    <div class="col-8">
        <h3><b>Manage Products</b></h3>
    </div>
    <div class="col-2">
        @if (_apiHealthCheckResult is null)
        {
            <a class="btn button-custom-primary-med form-control" @onclick="ApiHealthCheck">Check API Health</a>
        }
        else
        {
            <a class="btn button-custom-primary-med form-control" @onclick="ClearHealthCheckResult">Hide API Health</a>
        }
    </div>
    <div class="col-2">
        <a class="btn button-custom-danger-med form-control" @onclick="PurgeData">Purge Data</a>
    </div>
</div>

@if (_apiHealthCheckResult is not null)
{
    <HealthCheckResult ApiHealthCheckResult="@_apiHealthCheckResult" />
}

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="row mt-2">
        <div class="col-10">
            <h5 class="text-danger"><b>Error:</b></h5>
        </div>
        <div class="col-2">
            <a class="btn btn-warning form-control" @onclick="ClearErrorMessage">Clear Errors</a>
        </div>
    </div>
    <div class="row mt-2">
        <div class="col-12 text-center">
            <textarea rows="2" class="bg-dark text-danger form-control">@_errorMessage</textarea>
        </div>
    </div>
}
@if (!string.IsNullOrWhiteSpace(_successMessage))
{
    <h4>@_successMessage</h4>
}

<div class="row mt-2">
    <div class="col-2">
        <label for="aggId">Aggregate Id:</label>
        <input class="bg-dark text-light form-control" id="aggId" type="text" @bind="_aggregateIdString" @bind:after="RefreshData" />
    </div>

    <div class="col-2">
        <label for="cat">Category Filter:</label>
        <select class="bg-dark text-light form-select" id="cat" type="text" @bind="_categoryFilter" @bind:after="RefreshData">
            <option value=""></option>
            <option value="Astronomy">Astronomy</option>
            <option value="Books">Books</option>
            <option value="Computers">Computers</option>
            <option value="Electronics">Electronics</option>
            <option value="Music">Music</option>
            <option value="Photography">Photography</option>
            <option value="Sports">Sports</option>
        </select>
    </div>
    <div class="col-2">
        <label for="sort">Sort Column:</label>
        <select class="bg-dark text-light form-select" id="sort" type="text" @bind="_sortColumn" @bind:after="RefreshData">
            <option value=""></option>
            <option value="Name">Name</option>
            <option value="Price descending">Price Desc</option>
            <option value="Price ascending">Price Asc</option>
        </select>
    </div>

    <div class="col-2">
        <label for="pagesize">Page Size:</label>
        <input class="bg-dark text-light form-control" id="pagesize" type="number" @bind="_pageSize" @bind:after="RefreshData" />
    </div>
    <div class="col-2">
        <a class="btn button-custom-yellow-med form-control mt-4" @onclick="ClearFilters">Reset</a>
    </div>
    @if (!string.IsNullOrWhiteSpace(_successMessage) || !string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="col-2">
            <a class="btn button-custom-warning-med form-control mt-4" @onclick="ClearMessages">Clear Messages</a>
        </div>
    }
    else
    {
        <div class="col-2">
            <a class="btn button-custom-success-med form-control mt-4" @onclick="AddProduct">Add Product</a>
        </div>
    }
</div>

<div class="row mt-2">
    
    <div class="col-8">
    </div>
    
</div>
<div class="row mt-2">
    <div class="col-12">

        @if (_products is not null)
        {
            <table class="table table-dark table-bordered text-center">
                <thead class="bg-primary text-light">
                    <tr>
                        @* <th>Id</th> *@
                        <th>Name</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Currency</th>
                        <th>Status</th>
                        <th>Images</th>
                        <th>Documents</th>
                        <th>Version</th>
                        <th></th>
                        @* <th></th> *@
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in _products)
                    {
                        <tr>
                            @* <td>@product.Id</td> *@
                            <td>@product.Name</td>
                            <td>@product.Category</td>
                            <td>@product.Price</td>
                            <td>@product.Currency</td>
                            <td>@product.Status</td>
                            <td>@product.Images?.Count</td>
                            <td>@product.Documents?.Count</td>
                            <td>@product.Version</td>
                            <td>
                                <a class="btn button-custom-table-primary" @onclick="() => Detail(product.Id.ToString())">Manage</a>
                            </td>
                            @* <td>
                                <a class="btn button-custom-table-danger" @onclick="() => DeleteProduct(product.Id)">Delete</a>
                            </td> *@
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {

        }

    </div>
</div>

<div class="toolbar-paging">
    @if (_pagingData is not null)
    {
        <div class="row p-4">
            <div class="col-8">
                <ul class="pagination">
                    <li class="page-item">
                        <a class="btn button-custom-paging-arrow" role="button" @onclick="PageBackward">
                            <i class="bi-chevron-double-left text-primary-alt"></i>
                        </a>
                    </li>
                    @for (int i = 1; i <= _pagingData.TotalPageCount; i++)
                    {
                        int page = i;
                        if (page == _pagingData.CurrentPage)
                        {
                            <li class="page-item active">
                                <a class="btn button-custom-paging-current" role="button" @onclick="(() => PageTo(page))">
                                    <span class="text-info-alt">@i</span>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item">
                                <a class="btn button-custom-paging-page" role="button" @onclick="(() => PageTo(page))">
                                    <span class="text-primary-alt">@i</span>
                                </a>
                            </li>
                        }
                    }
                    <li class="page-item">
                        <a class="btn button-custom-paging-arrow" role="button" @onclick="PageForward">
                            <i class="bi-chevron-double-right text-primary-alt"></i>
                        </a>
                    </li>
                </ul>
            </div>
            <div class="col-4 ">
                <div class="row ">
                    <div class="col-6 text-center ">
                        <span class="text-primary-alt"><i>Page Size: @_pagingData.PageSize</i></span>
                    </div>
                    <div class="col-6 text-center ">
                        <span class="text-primary-alt"><i>Item Count: @_pagingData.TotalItemCount</i></span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (_addProductDTO is not null)
{
    <AddProductModal ModalTitle="Add Product" SubmitButtonTitle="Add Product" AddNewProductDTO="@_addProductDTO" Submit="SubmitAddProduct" CancelAddProduct="CancelAddProduct" />
}

@if (_purgeDataDTO is not null)
{
    <PurgeDataConfirmationModal ModalTitle="Confirm Purge Data" SubmitButtonTitle="Purge Data" PurgeDataDTO="@_purgeDataDTO" Submit="SubmitPurgeData" CancelPurgeData="CancelPurgeData" />
}

