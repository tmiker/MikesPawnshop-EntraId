@page "/dev/testProductsWriteApi"
@rendermode InteractiveServer
@inject IProductsWriteHttpService _writeSideHttpClient
@inject IConfiguration _configuration
@attribute [Authorize(Policy = "IsAdminOrManager")]

<PageTitle>Dev Testing</PageTitle>

<h3>Products Write Side API Exception Handling Testing</h3>

<div class="row mt-2">
    <div class="col-3">
        <label for="exceptionType" class="form-label">Exception Type:</label>
        <select id="exceptionType" class="bg-dark text-light form-select" @bind="_exceptionType">
            <option value="">-- Select Exception Type --</option>
            @foreach (var exceptionType in _exceptionTypeList)
            {
                <option value="@exceptionType">@exceptionType</option>
            }
        </select>
    </div>
</div>

<div class="row mt-2">
    <div class="col-3">
        <a class="btn button-custom-warning" @onclick="TestThrowExceptionAsync">Throw Exception</a>
    </div>
</div>

<div class="row mt-2">
    <div class="col-12">
        <textarea class="bg-dark text-light form-control" rows="12" readonly>@_errorMessage</textarea>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">
        <h5 class="text-info-alt">
            Notes:
        </h5>
    </div>
</div>
<div class="row mt-2">
    <div class="col-12">
        <p class="text-info-alt">
            Ensure API uses IProblemDetailsService to write the response so that response has content type of `application/problem+json`.
        </p>
    </div>
</div>
<div class="row mt-2">
    <div class="col-12">
        <p class="text-info-alt">
            Client HTTP Service checks for content type of `application/problem+json` and if present can parse or deserialize the response accordingly.
        </p>
    </div>
</div>
<div class="row mt-2">
    <div class="col-12">
        <p class="text-info-alt">
            The Products Write Side API has exception type specific ExceptionHandler for NotFoundException, ValidationException, and ProductEventStoreException, 
            while other exceptions are handled by a global ExceptionHandler.
        </p>
    </div>
</div>

<hr />
<div class="row mt-2">
    <div class="col-4">
        <a class="btn button-custom-primary" @onclick="GetCloudAMQPTestingDummyValue">Get Cloud AMQP Test Value</a>
    </div>
    <div class="col-8">
        <p class="text-info-alt mt-2">Gets Value from API which uses Options pattern for CloudAMQPSettings (_cloudAmqpSettings.Value.TestingDummyValue)</p>
    </div>
</div>
<div class="row mt-1">
    <div class="col-8">
        <p class="text-info-alt">Locally, the API configuration uses a nested entry (colon), while in Azure the configuraton uses a double underscore.</p>
    </div>
</div>
@if (!string.IsNullOrWhiteSpace(_cloudAMQPTestValue))
{
    <div class="row mt-2">
        <div class="col-12">
            <input type="text" class="bg-dark text-light form-control" @bind-value="@_cloudAMQPTestValue" />
        </div>
    </div>
    <div class="row mt-2">
        <div class="col offset-5">
            <a class="btn button-custom-warning" @onclick="ClearCloudAMQPTestValue">Clear</a>
        </div>
    </div>
}


@code {

    private List<string> _exceptionTypeList { get; } = new()
    {
        // "ProductEventStoreException",
        "ValidationException",
        "NotFoundException",
        "RequestFailedException",
        "ArgumentException",
        // "UnauthorizedAccessException",       // not configured to throw an exception - handled by .net core middleware
        // "ForbiddenException",                // not configured to throw an exception - handled by .net core middleware
        "ConflictException",
        // "ArgumentNullException",
        "InvalidOperationException",
        // "TaskCanceledException"
    };
    private string? _exceptionType;
    private ThrowExceptionDTO? _throwExceptionDTO;
    private CancellationTokenSource? _cts;
    private string? _cloudAMQPTestValue;
    private void ClearCloudAMQPTestValue() => _cloudAMQPTestValue = null;

    private string? _errorMessage;
    private void ClearErrorMessage() => _errorMessage = string.Empty;

    private async Task TestThrowExceptionAsync()
    {
        if (string.IsNullOrWhiteSpace(_exceptionType))
        {
            _errorMessage = "Please select an exception type to throw.";
            return;
        }

        _throwExceptionDTO = new ThrowExceptionDTO(_exceptionType);
        _cts = new CancellationTokenSource();
        var result = await _writeSideHttpClient.ThrowExceptionForTestingAsync(_throwExceptionDTO, _cts.Token);
        if (!result.IsSuccess)
        {
            _errorMessage = result.ErrorMessage;
        }
    }

    private async Task GetCloudAMQPTestingDummyValue()
    {
        _cts = new CancellationTokenSource();
        var writeApiResult = await _writeSideHttpClient.GetCloudAmqpSettingsTestingDummyValueAsync(_cts.Token);
        if (writeApiResult.IsSuccess) _cloudAMQPTestValue = writeApiResult.Value;
        else _cloudAMQPTestValue = $"Error: {writeApiResult.ErrorMessage}";
        
        // string? value = _configuration.GetSection("CloudAMQPSettings:TestingDummyValue").Value;
        // if (!string.IsNullOrWhiteSpace(value)) _cloudAMQPTestValue = value;
        // else _cloudAMQPTestValue = "No value found in configuration.";
        
    }
}