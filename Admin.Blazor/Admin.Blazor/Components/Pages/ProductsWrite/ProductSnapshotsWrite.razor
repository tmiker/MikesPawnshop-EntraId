@page "/products/productSnapshotsWrite"
@rendermode InteractiveServer
@inject IProductsWriteHttpService _writeSideHttpClient
@implements IDisposable
@attribute [Authorize(Policy = "IsAdminOrManager")]

<PageTitle>Write Side Products</PageTitle>

<div class="row mt-2">
    <div class="col-5">
        <h4><b>WRITE SIDE PRODUCT SNAPSHOTS</b></h4>
    </div>
    <div class="col-5 text-center">
        @if (_thinking)
        {
            <span class="loader-vertical-bars"></span>
        }
    </div>
    <div class="col-2">
    </div>
</div>

<h6 class="mt-2"><i>Record Count: @_productSnapshotCount</i></h6>
<h5 class="mt-2"><i>Products hydrated from Products.Write.API EventStore events, then mapped to Snapshots DTOs</i></h5>

@if (!string.IsNullOrWhiteSpace(_addResultString))
{
    <h6><b><i>Add Result: @_addResultString</i></b></h6>
    <a class="btn btn-success" @onclick="ClearAddResultString">Clear</a>
}

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="row mt-2">
        <div class="col-10">
            <h5 class="text-danger"><b>Error:</b></h5>
        </div>
        <div class="col-2">
            <a class="btn button-custom-warning-med form-control" @onclick="ClearErrorMessage">Clear Errors</a>
        </div>
    </div>
    <div class="row mt-2">
        <div class="col-12 text-center">
            <textarea rows="2" class="bg-dark text-danger form-control">@_errorMessage</textarea>
        </div>
    </div>
}

<div class="row mt-2">
    <div class="col-2">
        <label for="aggId">Aggregate Id:</label>
        <input id="aggId" type="text" class="bg-dark text-light form-control" @bind="_aggregateIdString" @bind:after="RefreshData" />
    </div>
    <div class="col-2">
        <label for="maxV">Max Version:</label>
        <input id="maxV" type="text" class="bg-dark text-light form-control" @bind="_maxVersion" @bind:after="RefreshData" />
    </div>
    <div class="col-2">
        <label for="pagesize">Page Size:</label>
        <input id="pagesize" type="number" class="bg-dark text-light form-control" @bind="_pageSize" @bind:after="RefreshData" />
    </div>
    <div class="col-2 offset-4">
        <a class="btn button-custom-yellow-med form-control mt-4" @onclick="ClearFilters">Reset</a>
    </div>
</div>

@if (_addImageDTO is not null)
{
    <div class="row mt-2">
        <div class="col-6 offset-3 text-center">
            <h5><b>Add Product Image</b></h5>
        </div>
    </div>
    <div class="row mt-2">
        <EditForm Model="_addImageDTO" OnValidSubmit="SubmitAddImage" FormName="AddProductImageForm">
            <DataAnnotationsValidator />
            <div class="col-12 text-center">
                <div class="form-group row">
                    <div class="col-3">
                        <label for="productId">Product Id:</label>
                    </div>
                    <div class="col-9">
                        <InputText inert class="bg-dark text-light form-control" id="productId" @bind-Value="@_addImageDTO.ProductId" />
                        <ValidationMessage For="@(() => _addImageDTO.ProductId)" />
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-3 text-center">
                        <label for="name">Name:</label>
                    </div>
                    <div class="col-9">
                        <InputText class="bg-dark text-light form-control" id="name" @bind-Value="@_addImageDTO.Name" />
                        <ValidationMessage For="@(() => _addImageDTO.Name)" />
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-3 text-center">
                        <label for="caption">Caption:</label>
                    </div>
                    <div class="col-9">
                        <InputText class="bg-dark text-light form-control" id="caption" @bind-Value="@_addImageDTO.Caption" />
                        <ValidationMessage For="@(() => _addImageDTO.Caption)" />
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-3 text-center">
                        <label for="desiredfilename">Desired File Name:</label>
                    </div>
                    <div class="col-9">
                        <InputText class="bg-dark text-light form-control" id="desiredfilename" @bind-Value="@_addImageDTO.BlobFileName" />
                        <ValidationMessage For="@(() => _addImageDTO.BlobFileName)" />
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-3 text-center">
                        <label for="file">Image to Add:</label>
                    </div>
                    <div class="col-9">
                        <InputFile class="bg-dark text-light form-control" typeof="file" id="file" OnChange="@OnImageInputFileChange" />
                        <ValidationMessage For="@(() => _addImageDTO.ImageBlob)" />
                    </div>
                </div>

                <br />
                <div class="row">
                    <div class="col-4 offset-3">
                        <button class="btn button-custom-success-med form-control" type="submit">Submit</button>
                    </div>
                    <div class="col-4 offset-1">
                        <a class="btn button-custom-primary-med form-control" @onclick="CancelAddImage">Cancel</a>
                    </div>
                </div>
            </div>
        </EditForm>
    </div>

}
@if (_addDocumentDTO is not null)
{
    <AddDocumentModal ModalTitle="Add Document" SubmitButtonTitle="Add Doc" DocumentToAdd="@_addDocumentDTO" Submit="SubmitAddDocument" Cancel="CancelAddDocument" />
}

<div class="row mt-2">
    <div class="col-12">

        @if (_productSnapshots is not null)
        {
            <table class="table table-sm table-dark table-bordered text-center">
                <thead class="bg-primary text-light">
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Images</th>
                        <th>Docs</th>
                        <th>Ver</th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in _productSnapshots)
                    {
                        <tr>
                            <td>@product.Id.ToString()[0..8]-...</td>
                            <td>@product.Name</td>
                            <td>@product.Category</td>
                            <td>@product.Price</td>
                            <td>@product.Images?.Count</td>
                            <td>@product.Documents?.Count</td>
                            <td>@product.Version</td>
                            <td>
                                <a class="btn button-custom-table-success" @onclick="() => AddImage(product.Id.ToString())">Add Image</a>
                            </td>
                            <td>
                                <a class="btn button-custom-table-danger" @onclick="() => DeleteImage(product.Id.ToString())">Delete Image </a>
                            </td>
                            <td>
                                <a class="btn button-custom-table-success" @onclick="() => AddDocument(product.Id.ToString())">Add Doc</a>
                            </td>
                            <td>
                                <a class="btn button-custom-table-danger" @onclick="() => DeleteDocument(product.Id.ToString())">Delete Doc </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <h4 class="text-info-alt mt-4">No products were found.</h4>
        }
    </div>
</div>

<div class="toolbar-paging">
    @if (_pagingData is not null)
    {
        <div class="row p-4">
            <div class="col-8">
                <ul class="pagination">
                    <li class="page-item">
                        <a class="btn button-custom-paging-arrow" role="button" @onclick="PageBackward">
                            <i class="bi-chevron-double-left text-primary-alt"></i>
                        </a>
                    </li>
                    @for (int i = 1; i <= _pagingData.TotalPageCount; i++)
                    {
                        int page = i;
                        if (page == _pagingData.CurrentPage)
                        {
                            <li class="page-item active">
                                <a class="btn button-custom-paging-current" role="button" @onclick="(() => PageTo(page))">
                                    <span class="text-info-alt">@i</span>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item">
                                <a class="btn button-custom-paging-page" role="button" @onclick="(() => PageTo(page))">
                                    <span class="text-primary-alt">@i</span>
                                </a>
                            </li>
                        }
                    }
                    <li class="page-item">
                        <a class="btn button-custom-paging-arrow" role="button" @onclick="PageForward">
                            <i class="bi-chevron-double-right text-primary-alt"></i>
                        </a>
                    </li>
                </ul>
            </div>
            <div class="col-4 ">
                <div class="row ">
                    <div class="col-6 text-center ">
                        <span class="text-primary-alt"><i>Page Size: @_pagingData.PageSize</i></span>
                    </div>
                    <div class="col-6 text-center ">
                        <span class="text-primary-alt"><i>Item Count: @_pagingData.TotalItemCount</i></span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {

    private List<ProductSnapshotDTO>? _productSnapshots;

    private string? _aggregateIdString = null;
    private int _minVersion = 0;
    private int _maxVersion = Int32.MaxValue;

    private int _pageNumber = 1;
    private int _pageSize = 8;
    private PaginationMetadata? _pagingData;
    private bool _thinking;

    private int _productSnapshotCount;

    private string? _errorMessage;
    private void ClearErrorMessage() => _errorMessage = null;

    private CancellationTokenSource? _cancellationTokenSource = new CancellationTokenSource();
    private async Task CancelOperationAsync() => await _cancellationTokenSource!.CancelAsync();

    //// ****************** ADD AND REMOVE IMAGES AND DOCUMENTS START *******************

    private AddImageDTO? _addImageDTO;
    private AddDocumentDTO? _addDocumentDTO;
    private string? _addResultString;
    private void ClearAddResultString() => _addResultString = null;

    private void AddImage(string productId) => _addImageDTO = new AddImageDTO() { ProductId = productId };
    private void CancelAddImage() => _addImageDTO = null;
    private async Task SubmitAddImage()
    {
        var addImageResult = await _writeSideHttpClient.AddProductImageAsync(_addImageDTO!, _cancellationTokenSource!.Token);
        _addResultString = addImageResult.IsSuccess ? "Success" : addImageResult.ErrorMessage;
        _addImageDTO = null;
    }
    private string[] _allowedImageFileTypes = new string[] { "image/jpeg", "image/bmp", "image/png", "image/gif" };
    private async Task OnImageInputFileChange(InputFileChangeEventArgs e)
    {
        if (!_allowedImageFileTypes.Contains(e.File.ContentType)) _addResultString = "Invalid file format. Files must be of type png, jpeg, bmp, or gif.";
        var image = await e.File.RequestImageFileAsync(e.File.ContentType, 600, 600);  // should just return file as is if dims both < 600
        _addImageDTO!.ImageBlob = image;
    }

    private void AddDocument(string productId) => _addDocumentDTO = new AddDocumentDTO() { ProductId = productId };
    private void CancelAddDocument() => _addDocumentDTO = null;
    private async Task SubmitAddDocument()
    {
        if (_addDocumentDTO!.DocumentBlob is not null) Console.WriteLine($"The RAZOR PAGE SUBMIT Document Blob IS NOT null.");
        else Console.WriteLine($"The RAZOR PAGE SUBMIT Document Blob IS null.");
        var addDocumentResult = await _writeSideHttpClient.AddProductDocumentAsync(_addDocumentDTO!, _cancellationTokenSource!.Token);
        _addResultString = addDocumentResult.IsSuccess ? "Success" : addDocumentResult.ErrorMessage;
        _addDocumentDTO = null;
    }

    private DeleteImageDTO? _deleteImageDTO;
    private async Task DeleteImage(string productId)
    {
        _deleteImageDTO = new DeleteImageDTO(productId, "The first image will be deleted if any", null);
        var result = await _writeSideHttpClient.DeleteProductImageAsync(_deleteImageDTO);
        _addResultString = result.IsSuccess ? "Success" : result.ErrorMessage;
        _deleteImageDTO = null;
    }
    private void CancelDeleteImage() => _deleteImageDTO = null;
    private async Task SubmitDeleteImage()
    {
        var result = await _writeSideHttpClient.DeleteProductImageAsync(_deleteImageDTO!);
        _addResultString = result.IsSuccess ? "Success" : result.ErrorMessage;
        _deleteImageDTO = null;
    }

    private DeleteDocumentDTO? _deleteDocumentDTO;
    private async Task DeleteDocument(string productId)
    {
        _deleteDocumentDTO = new DeleteDocumentDTO(productId, "The first document will be deleted if any", null);
        var result = await _writeSideHttpClient.DeleteProductDocumentAsync(_deleteDocumentDTO);
        _addResultString = result.IsSuccess ? "Success" : result.ErrorMessage;
        _deleteDocumentDTO = null;
    }
    private void CancelDeleteDocument() => _deleteDocumentDTO = null;
    private async Task SubmitDeleteDocument()
    {
        var result = await _writeSideHttpClient.DeleteProductDocumentAsync(_deleteDocumentDTO!);
        _addResultString = result.IsSuccess ? "Success" : result.ErrorMessage;
        _deleteDocumentDTO = null;
    }

    //// ****************** ADD AND REMOVE IMAGES AND DOCUMENTS END *******************

    private async Task ClearFilters()
    {
        _aggregateIdString = null;
        _minVersion = 0;
        _maxVersion = Int32.MaxValue;

        await RefreshData();
    }

    private async Task PageForward()
    {
        if (_pagingData is null || _pageNumber >= _pagingData.TotalPageCount) return;
        _pageNumber = _pageNumber + 1;
        await RefreshData();
    }

    private async Task PageBackward()
    {
        if (_pageNumber <= 1) return;
        _pageNumber = _pageNumber - 1;
        await RefreshData();
    }

    private async Task PageTo(int page)
    {
        if (page == _pagingData!.CurrentPage || page < 0 || page > _pagingData.TotalPageCount) return;
        _pageNumber = page;
        await RefreshData();
    }

    private async Task RefreshData()
    {
        _thinking = true;
        var snapshotsResult = await _writeSideHttpClient.GetPagedProductSnapshotsAsync(_aggregateIdString, _minVersion, _maxVersion, _pageNumber, _pageSize);
        if (snapshotsResult.IsSuccess)
        {
            if (snapshotsResult.ProductSnapshots is not null && snapshotsResult.ProductSnapshots.Any())
            {
                _productSnapshots = snapshotsResult.ProductSnapshots.ToList();
                _pagingData = snapshotsResult.PagingData;
                _productSnapshotCount = _productSnapshots.Count;
            }
        }
        else _errorMessage = snapshotsResult.ErrorMessage;
        _thinking = false;
    }


    protected override async Task OnAfterRenderAsync(bool isFirstRender)
    {
        if (isFirstRender)
        {
            await RefreshData();
            this.StateHasChanged();
        }
    }

    protected override void OnInitialized()
    {
        _thinking = true;
    }


    public void Dispose()
    {
        _cancellationTokenSource?.Cancel();
        _cancellationTokenSource?.Dispose();
        _cancellationTokenSource = null;
    }

}
