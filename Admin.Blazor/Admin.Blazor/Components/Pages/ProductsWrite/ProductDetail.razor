@page "/products/productDetail/{aggregateId}"
@rendermode InteractiveServer
@inject IProductsWriteHttpService _writeSideHttpClient
@inject IToastrService Toastr
@attribute [Authorize(Policy = "IsAdminOrManager")]

<PageTitle>Manage Products</PageTitle>

<ErrorComponent ErrorMessage="@_errorMessage" SuccessMessage="@_successMessage" ClearErrorCallback="ClearErrorMessage" ClearSuccessCallback="ClearSuccessMessage" />

<div class="row mt-2">
    <div class="col-6">
        <h3><b>Manage Product</b></h3>
    </div>
    <div class="col-5 text-end">Azure Blob Storage:</div>
    <div class="col-1 text-start">
        @if (!_azureStorageWasChecked)
        {
            <i class="bi-circle-fill text-secondary-alt mx-2 mt-2" title="Check Azure Storage connection." style="cursor:pointer;" @onclick="CheckAzureStorageStatus"></i>
        }
        else if (_azureStorageConnected)
        {
            <i class="bi-circle-fill text-success-alt mx-2 mt-2" title="Check Azure Storage connection. Last check OK." style="cursor:pointer;" @onclick="CheckAzureStorageStatus"></i>
        }
        else
        {
            <i class="bi-circle-fill text-danger-alt mx-2 mt-2" title="Check Azure Storage connection. Last check faied." style="cursor:pointer;" @onclick="CheckAzureStorageStatus"></i>
        }
    </div>
</div>

@if (_product is not null)
{
    <div class="row mt-2">
        <div class="col-6">
            <!-- COLUMN 1 START-->
            <div class="form-group row">
                <div class="col-3">
                    <label for="aggId">Aggregate Id:</label>
                </div>
                <div class="col-8">
                    <InputText inert class="bg-dark text-light form-control" id="aggId" @bind-Value="@_productAggregateId" />
                </div>
            </div>
            <div class="form-group row">
                <div class="col-3">
                    <label for="name">Name:</label>
                </div>
                <div class="col-8">
                    <InputText class="bg-dark text-light form-control " id="name" @bind-Value="@_product.Name" />
                </div>
            </div>
            <div class="form-group row">
                <div class="col-3">
                    <label for="category">Category:</label>
                </div>
                <div class="col-8">
                    <InputText class="bg-dark text-light form-control " id="category" @bind-Value="@_product.Category" />
                </div>
            </div>
            <div class="form-group row">
                <div class="col-3">
                    <label for="description">Description:</label>
                </div>
                <div class="col-8">
                    <InputTextArea rows="4" class="bg-dark text-light form-control " id="description" @bind-Value="@_product.Description" />
                </div>
            </div>


            <div class="row m-0 p-0">
                <div class="col-6">
                    <div class="form-group row">
                        <div class="col-3">
                            <label for="price">Price:</label>
                        </div>
                        <div class="col-8">
                            <InputNumber class="bg-dark text-light form-control " id="price" @bind-Value="@_product.Price" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-3">
                            <label for="status">Status:</label>
                        </div>
                        <div class="col-8">
                            <InputText class="bg-dark text-light form-control" id="status" @bind-Value="@_product.Status" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-3">
                            <label for="qoh">On Hand:</label>
                        </div>
                        <div class="col-8">
                            <InputNumber class="bg-dark text-light form-control " id="qoh" @bind-Value="_product.QuantityOnHand" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-3">
                            <label for="allocated">Allocated:</label>
                        </div>
                        <div class="col-8">
                            <InputNumber class="bg-dark text-light form-control " id="allocated" @bind-Value="_product.QuantityAllocated" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-3">
                            <label for="imageCount">Image Count:</label>
                        </div>
                        <div class="col-8">
                            <InputNumber class="bg-dark text-light form-control" id="imageCount" @bind-Value="@_imageCount" />
                        </div>
                    </div>



                </div>
                <div class="col-6">
                    <div class="form-group row">
                        <div class="col-3">
                            <label for="currency">Currency:</label>
                        </div>
                        <div class="col-8">
                            <InputText class="bg-dark text-light form-control " id="currency" @bind-Value="@_product.Currency" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-3">
                            <label for="version">Version:</label>
                        </div>
                        <div class="col-8">
                            <InputNumber class="bg-dark text-light form-control" id="version" @bind-Value="@_product.Version" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-3">
                            <label for="uom">UOM:</label>
                        </div>
                        <div class="col-8">
                            <InputText class="bg-dark text-light form-control " id="uom" @bind-Value="_product.UOM" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-3">
                            <label for="lowstock">Low Stock Amount:</label>
                        </div>
                        <div class="col-8">
                            <InputNumber class="bg-dark text-light form-control " id="lowstock" @bind-Value="_product.LowStockThreshold" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-3">
                            <label for="docCount">Document Count:</label>
                        </div>
                        <div class="col-8">
                            <InputNumber class="bg-dark text-light form-control" id="docCount" @bind-Value="@_documentCount" />
                        </div>
                    </div>



                </div>
            </div>

            <br />
            <!-- COLUMN 1 END -->
            
            <br />
            <div class="row">
                <div class="col-4 offset-5">
                    <a class="btn button-custom-primary form-control" href="/products/productsList">Back</a>
                </div>
            </div>
        </div>
        <div class="col-6 text-center">
            <!-- COLUMN 2 START -->

            <div class="row mt-2">
                @if (_showDocuments)
                {
                    <div class="col-4">
                        <a class="btn button-custom-info form-control" @onclick="ToogleShowDocuments">Show Images</a>
                    </div>
                }
                else
                {
                    <div class="col-4">
                        <a class="btn button-custom-info form-control" @onclick="ToogleShowDocuments">Show Documents</a>
                    </div>
                }
                <div class="col-4">
                    <a class="btn button-custom-success form-control" @onclick="AddImage">Add Image</a>
                </div>
                <div class="col-4">
                    <a class="btn button-custom-success form-control" @onclick="AddDocument">Add Document</a>
                </div>
            </div>

            <hr />

            @if (_showDocuments)
            {
                if (_product.Documents is not null && _product.Documents.Any())
                {
                    <div class="row mt-2">
                        <div class="col-12 text-center ">
                            <h5><b>Documents</b></h5>
                        </div>
                    </div>

                    <table class="table table-dark table-bordered mt-2">
                        <thead>
                            <tr>
                                <th>Seq. No.</th>
                                <th>File Name</th>
                                <th>Title</th>
                                <th></th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var doc in _product.Documents)
                            {
                                <tr>
                                    <td>@doc.SequenceNumber</td>
                                    <td>@doc.Name</td>
                                    <td>@doc.Title</td>
                                    <td>
                                        <a class="btn button-custom-table-primary" href="@doc.DocumentUrl">View</a>
                                    </td>
                                    <td>
                                        <a class="btn button-custom-table-danger" @onclick="() => DeleteDocument(doc.Name!)">Delete</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <h5 class="mt-2"><i>There are currently no product documents.</i></h5>
                }
            }
            else
            {
                // show images
                if (_product.Images is not null && _product.Images.Any())
                {
                    <div class="row mt-2">
                        <div class="col-12 text-center ">
                            <h5><b>Images</b></h5>
                        </div>
                    </div>
                    @if (_primaryImage != null)
                    {
                        <div class="row">
                            <div class="col-12 text-center">
                                <img src="@_primaryImage.ImageUrl" width="400" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12 text-center">
                                <p class="text-primary"><i>@_primaryImage.Caption</i></p>
                            </div>
                        </div>
                    }
                    <div class="row">
                        @if (_primaryImage != null)
                        {
                            <div class="col-1 text-center ">
                                <span><i>@_primaryImage.SequenceNumber</i></span>
                            </div>
                            <div class="col-6 offset-2 text-center">
                                <span><i>@_primaryImage.Name</i></span>
                            </div>
                            @* <div class="col-1 offset-2 text-center">
                                <a class="btn btn-sm btn-danger " @onclick="(() => DeleteImage(_primaryImage.Name!))">&#128465;</a>
                            </div> *@
                            <div class="col-1 offset-2 text-center">
                                <a class="btn button-custom-toolbar-char-danger" title="Delete image" role="button" @onclick="(() => DeleteImage(_primaryImage.Name!))">
                                    <i class="bi-trash2"></i>
                                </a>
                            </div>
                        }
                    </div>
                   @*  <hr/>
                    <div class="row">
                            <div class="row">
                            @foreach (var thumb in _product.Images)
                            {
                                <div class="col-3 text-center">
                                    <img src="@thumb.ThumbnailUrl" width="100" />
                                    <label class="text-primary"><i>@thumb.Caption</i></label>
                                </div>
                            }
                            </div>
                    </div> *@
                }
                else
                {
                    <h5 class="mt-2"><i>There are currently no product images.</i></h5>
                }

                <br />

                <div class="row">
                    @if (_product.Images != null && _product.Images.Any())
                    {
                        @foreach (var image in _product.Images)
                        {
                            <div class="col-2">
                                @if (image.SequenceNumber == _primaryImage?.SequenceNumber)
                                {
                                    <img src="@image.ThumbnailUrl" width="100" style="border:2px solid blue;" />
                                }
                                else
                                {
                                    <img src="@image.ThumbnailUrl" width="100" style="cursor:pointer;" @onclick="(() => SetPrimaryImage(image.SequenceNumber))" />
                                }
                            </div>
                        }
                    }
                </div>
            }

            <!-- COLUMN 2 END -->
        </div>
    </div>
}

@if (_addImageDTO is not null)
{
    <AddImageModal ModalTitle="Add Image" SubmitButtonTitle="Add Image" ImageToAdd="@_addImageDTO" Submit="SubmitAddImage" Cancel="CancelAddImage" />
}
@if (_addDocumentDTO is not null)
{
    <AddDocumentModal ModalTitle="Add Document" SubmitButtonTitle="Add Document" DocumentToAdd="@_addDocumentDTO" Submit="SubmitAddDocument" Cancel="CancelAddDocument" />
}
@if (_deleteImageDTO is not null)
{
    <DeleteImageModal ModalTitle="Confirm Delete Image" SubmitButtonTitle="Delete" ImageToDelete="@_deleteImageDTO" Submit="SubmitDeleteImage" Cancel="CancelDeleteImage" />
}
@if (_deleteDocumentDTO is not null)
{
    <DeleteDocumentModal ModalTitle="Confirm Delete Document" SubmitButtonTitle="Delete" DocumentToDelete="@_deleteDocumentDTO" Submit="SubmitDeleteDocument" Cancel="CancelDeleteDocument" />
}

@code {

    [Parameter]
    public string? aggregateId { get; set; }

    private ProductSnapshotDTO? _product;
    private string? _productAggregateId;
    private int _imageCount;
    private int _documentCount;

    // private bool _azureStorageStatus;
    private bool _azureStorageWasChecked = false;
    private bool _azureStorageConnected = false;

    private string? _errorMessage;
    private string? _successMessage;
    private void ClearErrorMessage() => _errorMessage = null;
    private void ClearSuccessMessage() => _successMessage = null;
    
    // private bool _showAddImageView { get; set; }
    private ImageDataSnapshotDTO? _primaryImage { get; set; }

    private bool _showDocuments = false;
    private void ToogleShowDocuments() => _showDocuments = !_showDocuments;

    private void SetPrimaryImage(int sequenceNumber)
    {
        var primaryImage = _product!.Images?.FirstOrDefault(i => i.SequenceNumber == sequenceNumber);
        if (primaryImage != null)
        {
            _primaryImage = primaryImage;
        }
    }

    //// ****************** ADD AND REMOVE IMAGES AND DOCUMENTS START *******************

    private CancellationTokenSource? _cancellationTokenSource;

    private AddImageDTO? _addImageDTO;
    private void AddImage() => _addImageDTO = new AddImageDTO() { ProductId = _product!.Id.ToString() };
    private void CancelAddImage() => _addImageDTO = null;
    private async Task SubmitAddImage()
    {
        if (_addImageDTO is null) return;
        _cancellationTokenSource = new CancellationTokenSource();
        var addImageResult = await _writeSideHttpClient.AddProductImageAsync(_addImageDTO, _cancellationTokenSource.Token);
        if (addImageResult.IsSuccess)
        {
            _imageCount++;
            await Toastr.ShowToastrSuccess($"Image successfully added.");
        }
        else _errorMessage = addImageResult.ErrorMessage;
        _addImageDTO = null;
        _cancellationTokenSource = null;
        await ReloadAsync();  
    }

    private AddDocumentDTO? _addDocumentDTO;
    private void AddDocument() => _addDocumentDTO = new AddDocumentDTO() { ProductId = _product!.Id.ToString() };
    private void CancelAddDocument() => _addDocumentDTO = null;
    private async Task SubmitAddDocument()
    {
        _cancellationTokenSource = new CancellationTokenSource();
        var addDocumentResult = await _writeSideHttpClient.AddProductDocumentAsync(_addDocumentDTO!, _cancellationTokenSource.Token);
        if (addDocumentResult.IsSuccess)
        {
            _documentCount++;
            await Toastr.ShowToastrSuccess($"Document successfully added.");
        }
        else _errorMessage = addDocumentResult.ErrorMessage;
        _addDocumentDTO = null;
        _cancellationTokenSource = null;
        await ReloadAsync(); 
    }

    private DeleteImageDTO? _deleteImageDTO;
    private void DeleteImage(string filename)
    {
        if (string.IsNullOrWhiteSpace(filename)) _errorMessage = "The document file name is null or empty.";
        if (_product!.Images is not null)
        {            
            _deleteImageDTO = new DeleteImageDTO(_product!.Id.ToString(), filename, null);
        }
        else _errorMessage = $"There are no product images.";
    }
    private void CancelDeleteImage() => _deleteImageDTO = null;
    private async Task SubmitDeleteImage()
    {
        try
        {
            // var result = await _writeSideHttpClient.DeleteProductImageAsync(_deleteImageDTO!);
            // if (result.IsSuccess) await Toastr.ShowToastrSuccess($"Image successfully deleted.");
            // else _errorMessage = result.ErrorMessage;
            _deleteImageDTO = null;
            await Toastr.ShowToastrInfo($"Contact the application owner to enable this feature.");
            // await ReloadAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private DeleteDocumentDTO? _deleteDocumentDTO;
    private async Task DeleteDocument(string filename)
    {
        if (string.IsNullOrWhiteSpace(filename)) _errorMessage = "The document file name is null or empty.";
        if (_product!.Documents is not null)
        {
            _deleteDocumentDTO = new DeleteDocumentDTO(_product!.Id.ToString(), filename, null);
        }
        else
        {
            _errorMessage = $"There are no product documents.";
        }
    }
    private void CancelDeleteDocument() => _deleteDocumentDTO = null;
    private async Task SubmitDeleteDocument()
    {
        try
        {
            // var result = await _writeSideHttpClient.DeleteProductDocumentAsync(_deleteDocumentDTO!);
            // if (result.IsSuccess) await Toastr.ShowToastrSuccess($"Document successfully deleted.");
            // else _errorMessage = result.ErrorMessage;
            _deleteDocumentDTO = null;
            await Toastr.ShowToastrInfo($"Contact the application owner to enable this feature.");
            // await ReloadAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task ReloadAsync()
    {
        var result = await _writeSideHttpClient.GetProductSnapshotByIdAsync(aggregateId);
        if (result.IsSuccess)
        {
            _product = result.ProductSnapshot;
            if (_product is not null)
            {
                _productAggregateId = _product.Id.ToString();
                if (_product.Images is not null && _product.Images.Any())
                {
                    _primaryImage = _product.Images[0];
                    _imageCount = _product.Images.Count;
                }
                else _imageCount = 0;
                if (_product.Documents is not null && _product.Documents.Any())
                {
                    _documentCount = _product.Documents.Count;
                }
                else _documentCount = 0;
            }
        }
        else _errorMessage = result.ErrorMessage;
    }

    private async Task CheckAzureStorageStatus()
    {
        var pingResult = await _writeSideHttpClient.CheckAzureStorageStatusAsync();
        if (pingResult.IsSuccess) _azureStorageConnected = true;       
        else _azureStorageConnected = false;
        _azureStorageWasChecked = true;
    }

    protected override async Task OnAfterRenderAsync(bool isFirstRender)
    {
        if (isFirstRender)
        {
            var result = await _writeSideHttpClient.GetProductSnapshotByIdAsync(aggregateId);
            if (result.IsSuccess)
            {
                _product = result.ProductSnapshot;
                if (_product is not null)
                {
                    _productAggregateId = _product.Id.ToString();
                    if (_product.Images is not null && _product.Images.Any())
                    {
                        _primaryImage = _product.Images[0];
                        _imageCount = _product.Images.Count;
                    }
                    if (_product.Documents is not null)
                    {
                        _documentCount = _product.Documents.Count;
                    }
                }
                // await CheckAzureStorageStatus();
            }
            else _errorMessage = result.ErrorMessage;
            this.StateHasChanged();
        }
    }
}

