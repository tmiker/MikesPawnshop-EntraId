@using Admin.Blazor.Client.DTOs.Products.Write

<div class="modal fade show d-block" tabindex="-1" role="dialog">
    <div class="modal-backdrop fade show" @onclick="Cancel"></div>
    <div class="modal-dialog modal-lg" style="z-index: 1050">
        <div class="modal-content rounded-3 border">

            <div class="modal-header text-danger">
                <h5>@ModalTitle</h5>
            </div>

            <div class="modal-body">

                <EditForm Model="@StatusUpdateDTO" OnValidSubmit="Submit" FormName="UpdateProductStatusModalForm">
                    <DataAnnotationsValidator />
                    @if (StatusUpdateDTO != null)
                    {
                        <div class="form-group row">
                            <div class="col-3">
                                <label for="aggId">Aggregate Id:</label>
                            </div>
                            <div class="col-9">
                                <InputText inert class="form-control bg-dark text-light " id="aggId" @bind-Value="@StatusUpdateDTO.ProductId" />
                                <ValidationMessage For="@(() => StatusUpdateDTO.ProductId)" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-3 ">
                                <label for="name">Name:</label>
                            </div>
                            <div class="col-9">
                                <InputSelect class="bg-dark text-light form-select" id="statusSelect" @bind-Value="@StatusUpdateDTO.Status">
                                    <option value="Active">Active</option>
                                    <option value="InActive">InActive</option>
                                    <option value="Obsolete">Obsolete</option>
                                </InputSelect>
                                <ValidationMessage For="@(() => StatusUpdateDTO.Status)" />
                            </div>
                        </div>
                        <br />
                        <div class="row mt-2">
                            <div class="col-4 offset-3">
                                <button class="btn button-modal-primary form-control bg-dark text-light " @onclick="Cancel">Cancel</button>
                            </div>
                            <div class="col-4 offset-1">
                                <button class="btn button-modal-success form-control bg-dark text-light " type="submit">Submit</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="row">
                            <div class="col-12">
                                <h5 class="text-danger"><b><i>Error: Insufficient data provided.</i></b></h5>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-4 offset-4 text-center">
                                <button class="btn button-modal-primary form-control bg-dark text-light " @onclick="Cancel">Cancel</button>
                            </div>
                        </div>
                    }
                </EditForm>
            </div>
            <div class="modal-footer">
                <p>Footer</p>
            </div>
        </div>
    </div>
</div>

@code {

    [Parameter]
    public UpdateStatusDTO? StatusUpdateDTO { get; set; }

    [Parameter]
    public string? ModalTitle { get; set; }

    [Parameter]
    public EventCallback Submit { get; set; }

    [Parameter]
    public string SubmitButtonTitle { get; set; } = "Update";

    [Parameter]
    public EventCallback Cancel { get; set; }

}
