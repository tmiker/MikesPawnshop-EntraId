@page "/claims/accountsApiClaims"
@rendermode InteractiveServer
@inject IClaimsHttpService _claimsService
@inject IToastrService Toastr

<PageTitle>Accounts API Claims</PageTitle>

<div class="mt-1">
    <ErrorComponent SuccessMessage="@_successMessage" ErrorMessage="@_errorMessage" ClearSuccessCallback="ClearSuccessMessage" ClearErrorCallback="ClearErrorMessage" />
</div>

<div class="mr-toolbar-bottom">

    <div class="mr-toolbar-group">
        <label class="mr-toolbar-label">API:</label>
        <select class="form-select mr-toolbar-select-medium" id="api" @bind="_api" @bind:after="(() => FilterSortAndPageData(true))">
            <option value="accounts">Accounts API</option>
            <option value="carts">Carts API</option>
            <option value="orders">Orders API</option>
            <option value="products_write">Products Write API</option>
        </select>
    </div>
    <div class="mr-toolbar-group">
        <label class="mr-toolbar-label">Source:</label>
        <select class="form-select mr-toolbar-select-medium" id="source" @bind="_claimSource" @bind:after="(() => FilterSortAndPageData(true))">
            <option value="access_token">Access Token</option>
            <option value="claims_principal">Claims Principal</option>
            <option value="difference">Difference</option>
        </select>
    </div>

    <div class="mr-toolbar-group">
        <label class="mr-toolbar-label">Filter: </label>
        <input class="mr-toolbar-input-medium" @bind="@_filter" @bind:after="(() => FilterSortAndPageData(true))" />
        @if (string.IsNullOrWhiteSpace(_filter))
        {
            <a class="btn mr-toolbar-btn-icon"> </a>
        }
        else
        {
            <a class="btn mr-toolbar-btn-icon" @onclick="ClearFilter"> <i class="bi-fire text-warning-alt"></i> </a>
        }
    </div>
    <div class="mr-toolbar-group">
        <label class="mr-toolbar-label">Sort:</label>
        <select class="form-select mr-toolbar-select-short" id="sortColumn" @bind="_sortColumn" @bind:after="(() => FilterSortAndPageData(true))">
            <option value="type">Type</option>
            <option value="value">Value</option>
        </select>
    </div>
    <div class="mr-toolbar-group">
        <label class="mr-toolbar-label">Page Size: </label>
        <input type="number" min="1" class="mr-toolbar-input-very-small" @bind-value="@_pageSize" @bind-value:after="(() => FilterSortAndPageData(true))" />
    </div>
</div>

@if (_displayedClaims is not null && _displayedClaims.Any())
{
    <div class="mt-2">
        <div class="col-12">
            <h4>Accounts API Claims</h4>
            <table class="table table-sm table-dark table-bordered">
                <thead>
                    <tr>
                        <th>Claim Type</th>
                        <th>Claim Value</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var claim in _displayedClaims)
                    {
                        <tr>
                            <td>@claim.Type</td>
                            <td>@claim.Value</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (_pagingData is not null)
    {
        <PagingComponent PagingData="@_pagingData" PageBackwardCallback="PageBackward" PageForwardCallback="PageForward" GoToPageCallback="PageTo" />
    }
}

@if (_thinking)
{
    <div class="mx-auto text-center mb-3 mt-3">
        <div class="spinner-border text-yellow-alt role-status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}

@code {

    private ApiUserInfoDTO? _apiUserInfoDTO { get; set; }
    private List<ClaimDTO>? _accessTokenClaims;           // = new Dictionary<string, string>();
    private List<ClaimDTO>? _httpContextUserClaims;       // = new Dictionary<string, string>();
    private List<ClaimDTO>? _displayedClaims;
    private List<ClaimDTO>? _exceptClaims;
    private bool _thinking;

    private string _api = "accounts";
    private List<string> _claimSourceList = new List<string> { "access_token", "claims_principal", "difference" };
    private string _claimSource = "access_token";

    // ERROR COMPONENT MESSAGING
    #region Error Handling
    private string? _errorMessage;
    private string? _successMessage;
    private void ClearErrorMessage() => _errorMessage = null;
    private void ClearSuccessMessage() => _successMessage = null;
    private void ClearMessages()
    {
        _errorMessage = null;
        _successMessage = null;
    }
    #endregion Error Handling

    // QUERY SEARCH, FILTER, SORT
    #region Filter Sort Page
    private int _pageNumber = 1;
    private int _pageSize = 10;
    private string? _filter;
    private string? _sortColumn;
    private void ClearFilter() { _filter = null; FilterSortAndPageData(true); }
    private void ResetFilters()
    {
        _filter = null;
        _sortColumn = "type";
        FilterSortAndPageData(true);    // if pageNumber is not reset, need logic to ensure within page count
    }
    #endregion Filter Sort Page

    // PAGING
    #region Paging
    private PaginationMetadata? _pagingData;
    private void PageForward()
    {
        if (_pageNumber >= _pagingData?.TotalPageCount) return;
        _pageNumber++;
        FilterSortAndPageData(false);
    }
    private void PageBackward()
    {
        if (_pageNumber <= 1) return;
        _pageNumber--;
        FilterSortAndPageData(false);
    }
    private void PageTo(int page)
    {
        if (page == _pageNumber) return;
        if (_pageNumber > _pagingData?.TotalPageCount || _pageNumber < 1) return;
        _pageNumber = page;
        FilterSortAndPageData(false);
    }
    #endregion Paging

    private void FilterSortAndPageData(bool resetPageNumber)
    {
        _thinking = true;
        IEnumerable<ClaimDTO>? claims = _claimSource switch
        {
            "access_token" => _accessTokenClaims,
            "claims_principal" => _httpContextUserClaims,
            "difference" => _exceptClaims,
            _ => _accessTokenClaims
        };

        if (claims is not null && claims.Any())
        {
            if (resetPageNumber) _pageNumber = 1;

            IQueryable<ClaimDTO> query = claims.AsQueryable();
            if (!string.IsNullOrWhiteSpace(_filter))
            {
                query = query.Where(c => c.Type != null && c.Type.ToLower().Contains(_filter.ToLower()) ||
                c.Value != null && c.Value.ToLower().Contains(_filter.ToLower()));
            }
            switch (_sortColumn)
            {
                case "type":
                    query = query.OrderBy(c => c.Type);
                    break;
                case "value":
                    query = query.OrderBy(c => c.Value);
                    break;
                default:
                    query = query.OrderBy(c => c.Type);
                    break;
            }

            List<ClaimDTO> claimsToDisplay = query.ToList();
            int count = claimsToDisplay.Count;
            _pagingData = new PaginationMetadata(count, _pageSize, _pageNumber);
            _displayedClaims = claimsToDisplay.Skip(_pageSize * (_pageNumber - 1)).Take(_pageSize).ToList();
        }

        _thinking = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var result = await _claimsService.GetAccountsApiUserInfoAsync();
            if (result.IsSuccess)
            {
                _apiUserInfoDTO = result.ApiUserInfo;
                ProcessApiInfo();
                FilterSortAndPageData(true);
            }
            else 
            {
                _apiUserInfoDTO = new ApiUserInfoDTO() { ErrorMessage = result.ErrorMessage };
                _errorMessage = result.ErrorMessage;
            }

            _thinking = false;
            this.StateHasChanged();
        }
    }

    private void ProcessApiInfo()
    {
        // claims principal has 24 claims, access token has 20 claims
        if (_apiUserInfoDTO is not null)
        {
            if (_apiUserInfoDTO.ApiAuthorizationHeaderClaimsList is not null && _apiUserInfoDTO.ApiAuthorizationHeaderClaimsList.Any()) 
                _accessTokenClaims = ParseListAsDictionaryOfTypeAndValue(_apiUserInfoDTO.ApiAuthorizationHeaderClaimsList).ToList();
            if (_apiUserInfoDTO.ApiUserClaimsClaimsList is not null && _apiUserInfoDTO.ApiUserClaimsClaimsList.Any()) 
                _httpContextUserClaims = ParseListAsDictionaryOfTypeAndValue(_apiUserInfoDTO.ApiUserClaimsClaimsList).ToList();
            if (_accessTokenClaims is not null && _httpContextUserClaims is not null)
            {
                _exceptClaims = (_httpContextUserClaims.Except(_accessTokenClaims)).ToList();        
            }
        }
    }

    private IEnumerable<ClaimDTO> ParseListAsDictionaryOfTypeAndValue(IEnumerable<string> list)
    {
        List<ClaimDTO> claims = new List<ClaimDTO>();

        if (list is not null && list.Any())
        {
            foreach (var entry in list)
            {
                int index = entry.IndexOf(':');
                if (index > 0)
                {
                    string key = entry[..index];
                    string value = entry[(index + 1)..];

                    if (!string.IsNullOrWhiteSpace(key) && !string.IsNullOrWhiteSpace(value))
                    {
                        key = key.Trim();
                        value = value.Trim();
                        @if (value.Length > 100) value = $"{value.Substring(0, 100)} ...";
                        claims.Add(new ClaimDTO(key, value));
                    }
                }
            }
        }
        return claims;
    }

    protected override void OnInitialized()
    {
        _thinking = true;
    }
}