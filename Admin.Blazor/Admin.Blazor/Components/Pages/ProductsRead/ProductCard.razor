﻿@if (Product != null)
{
    <div class="card mb-4">
        <div class="card-header bg-dark text-light">
            @Product.Name
        </div>
        <div class="card-body bg-dark text-light">
            <div class="row">
                @* <div class="col-6">
                    <span class="product-price">$@Product.Price</span>
                    <span class="product-uom">@Product.UOM</span>
                </div> *@

                <div class="col-6">
                    <div class="row">
                        <div class="col-12">
                            <span class="product-price">$@Product.Price</span>
                            <span class="product-uom">@Product.UOM</span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <AuthorizeView>
                                <Authorized>
                                    <a class="btn button-custom-table-primary" @onclick="ProductDetail">View</a>
                                    <a class="btn button-custom-table-primary" @onclick="AddToCart">Buy</a>
                                </Authorized>
                                <NotAuthorized>
                                    <a class="btn button-custom-table-primary" @onclick="ProductDetail">View</a>
                                </NotAuthorized>
                            </AuthorizeView>
                            
                        </div>
                    </div>
                </div>


                <div class="col-6">
                    <div class="text-end">
                        @if (Product.DefaultImageUri is not null)
                        {
                            <img class="rounded-top" src="@Product.DefaultImageUri" height="60" alt="placeholder" />
                        }
                        else
                        {
                            <img class="rounded" src="/images/image-pending.png" height="60" alt="placeholder" />
                        }
                    </div>
                </div>
            </div>
            <div class="row mt-2">
                <textarea rows="2" class="bg-dark text-light product-description small">@Product.Description</textarea>
            </div>
        </div>
        @* <div class="card-footer bg-dark text-light text-center">
            <AuthorizeView>
                <Authorized>
                    <a class="btn btn-primary btn-sm" style="width:120px" @onclick="ProductDetail">Details</a>
                    <a class="btn btn-success btn-sm" style="width:120px" @onclick="AddToCart">Add to Cart</a>
                </Authorized>
                <NotAuthorized>
                    <a class="btn btn-primary btn-sm" style="width:120px" @onclick="ProductDetail">Details</a>
                </NotAuthorized>
            </AuthorizeView>
        </div> *@
    </div>
}
else
{
    <span class="text-danger"><b>Error retrieving product.</b></span>
}

@code {

    [Parameter]
    public ProductSummaryDTO? Product { get; set; }

    [Parameter]
    public EventCallback<string> AddToCartCallback { get; set; }

    [Parameter]
    public EventCallback<string> ProductDetailCallback { get; set; }

    private async Task AddToCart()
    {
        await AddToCartCallback.InvokeAsync(Product?.AggregateId.ToString());
    }

    private async Task ProductDetail()
    {
        await ProductDetailCallback.InvokeAsync(Product?.AggregateId.ToString());
    }
}









