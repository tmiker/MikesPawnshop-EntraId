@page "/products/productsRead"
@rendermode InteractiveServer
@* @inject IProductsReadHttpService _productReadSideHttpClient *@
@inject IPublicProductsReadHttpService _readProductsClient
@attribute [Authorize(Policy = "IsAdminOrManager")]

<div class="row mt-2">
    <div class="col-10">
        <h4><b>READ SIDE PRODUCTS</b></h4>
    </div>
    <div class="col-2">
        @if (_apiHealthCheckResult is null)
        {
            <a class="btn button-custom-yellow-med form-control" @onclick="ApiHealthCheck">Check API Health</a>
        }
        else
        {
            <a class="btn button-custom-yellow-med form-control" @onclick="ClearHealthCheckResult">Hide API Health</a>
        }
    </div>
</div>

@if (_apiHealthCheckResult is not null)
{
    <HealthCheckResult ApiHealthCheckResult="@_apiHealthCheckResult" />
}

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="row mt-2">
        <div class="col-10">
            <h5 class="text-warning-alt"><b>Error:</b></h5>
        </div>
        <div class="col-2">
            <a class="btn button-custom-warning-med form-control" @onclick="ClearErrorMessage">Clear Errors</a>
        </div>
    </div>
    <div class="row mt-2">
        <div class="col-12 text-center">
            <textarea rows="2" class="bg-dark text-warning-alt form-control">@_errorMessage</textarea>
        </div>
    </div>
}

<div class="row mt-2">
    <div class="col-2">
        <label for="namefilter">Name Filter:</label>
        <input id="namefilter" type="text" class="bg-dark text-light form-control" @bind="_nameFilter" @bind:after="RefreshData" />
    </div>
    <div class="col-2">
        <label for="categoryfilter">Category Filter:</label>
        <input id="categoryfilter" type="text" class="bg-dark text-light form-control" @bind="_categoryFilter" @bind:after="RefreshData" />
    </div>
    <div class="col-2">
        <label for="sortcolumn">Sort Column:</label>
        <input id="sortcolumn" type="text" class="bg-dark text-light form-control" @bind="_sortColumn" @bind:after="RefreshData" />
    </div>
    <div class="col-2">
        <label for="pagesize">Page Size:</label>
        <input id="pagesize" type="number" class="bg-dark text-light form-control" @bind="_pageSize" @bind:after="RefreshData" />
    </div>
    <div class="col-2 offset-2">
        <a class="btn btn-sm btn-warning form-control mt-4" @onclick="ClearFilters">Reset</a>
    </div>
</div>

<div class="row mt-2">
    <div class="col-12">

        @if (_productSummaries is not null)
        {
            <table class="table table-dark table-bordered text-center">
                <thead class="bg-primary text-light">
                    <tr>
                        <th>Id</th>
                        <th>Aggregate Id</th>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Currency</th>
                        <th>Status</th>
                        <th>Images</th>
                        <th>Docs</th>
                        <th>Ver</th>
                        <th>On Hand</th>
                        <th>Allocated</th>
                        <th>Available</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in _productSummaries)
                    {
                        <tr>
                            <td>@product.Id</td>
                            <td>@product.AggregateId.ToString()[0..8]-...</td>
                            <td>@product.Name</td>
                            <td>@product.Category</td>
                            <td>@product.Price</td>
                            <td>@product.Currency</td>
                            <td>@product.Status</td>
                            <td>@product.ImageCount</td>
                            <td>@product.DocumentCount</td>
                            <td>@product.Version</td>
                            <td>@product.QuantityOnHand</td>
                            <td>@product.QuantityAllocated</td>
                            <td>@product.QuantityAvailable</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            if (_thinking)
            {
                <div class="mx-auto text-center mb-3 mt-3">
                    <div class="spinner-border text-success-alt role-status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>

            }
            else
            {
                <div class="row mt-3">
                    <div class="col-12 text-center">
                        <h5><b><i>No products were found.</i></b></h5>
                    </div>
                </div>
            }
        }
    </div>
</div>

<div class="toolbar-paging">
    @if (_pagingData is not null)
    {
        <div class="row p-4">
            <div class="col-8">
                <ul class="pagination">
                    <li class="page-item">
                        <a class="btn button-custom-paging-arrow" role="button" @onclick="PageBackward">
                            <i class="bi-chevron-double-left text-primary-alt"></i>
                        </a>
                    </li>
                    @for (int i = 1; i <= _pagingData.TotalPageCount; i++)
                    {
                        int page = i;
                        if (page == _pagingData.CurrentPage)
                        {
                            <li class="page-item active">
                                <a class="btn button-custom-paging-current" role="button" @onclick="(() => PageTo(page))">
                                    <span class="text-info-alt">@i</span>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item">
                                <a class="btn button-custom-paging-page" role="button" @onclick="(() => PageTo(page))">
                                    <span class="text-primary-alt">@i</span>
                                </a>
                            </li>
                        }
                    }
                    <li class="page-item">
                        <a class="btn button-custom-paging-arrow" role="button" @onclick="PageForward">
                            <i class="bi-chevron-double-right text-primary-alt"></i>
                        </a>
                    </li>
                </ul>
            </div>
            <div class="col-4 ">
                <div class="row ">
                    <div class="col-6 text-center ">
                        <span class="text-primary-alt"><i>Page Size: @_pagingData.PageSize</i></span>
                    </div>
                    <div class="col-6 text-center ">
                        <span class="text-primary-alt"><i>Item Count: @_pagingData.TotalItemCount</i></span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {

    private List<ProductSummaryDTO>? _productSummaries;

    private string? _nameFilter = null;
    private string? _categoryFilter = null;
    private string? _sortColumn = "Name";
    private int _pageNumber = 1;
    private int _pageSize = 10;
    private PaginationMetadata? _pagingData;
    private int _productSummaryCount;
    private bool _thinking;

    private string? _errorMessage;
    private void ClearErrorMessage() => _errorMessage = null;

    private HealthCheckResultDTO? _apiHealthCheckResult;
    private void ClearHealthCheckResult() => _apiHealthCheckResult = null;
    private async Task ApiHealthCheck()
    {
        var result = await _readProductsClient.CheckHealthAsync();
        if (result.IsSuccess)
        {
            _apiHealthCheckResult = result.HealthCheckResultDTO;
        }
        else
        {
            _errorMessage = $"{result.ErrorMessage}";
        }
    }

    private async Task ClearFilters()
    {
        _nameFilter = null;
        _categoryFilter = null;
        _sortColumn = null;
        _pageSize = 10;
        await RefreshData();
    }

    private async Task PageForward()
    {
        if (_pagingData is null || _pageNumber >= _pagingData.TotalPageCount) return;
        _pageNumber = _pageNumber + 1;
        await RefreshData();
    }

    private async Task PageBackward()
    {
        if (_pageNumber <= 1) return;
        _pageNumber = _pageNumber - 1;
        await RefreshData();
    }

    private async Task PageTo(int page)
    {
        if (page == _pagingData!.CurrentPage || page < 0 || page > _pagingData.TotalPageCount) return;
        _pageNumber = page;
        await RefreshData();
    }

    private async Task RefreshData()
    {
        _thinking = true;
        var pagedProductSummariesResult = await _readProductsClient.GetPagedAndFilteredProductSummariesAsync(_nameFilter, _categoryFilter, _sortColumn, _pageNumber, _pageSize);
        if (pagedProductSummariesResult.IsSuccess)
        {
            if (pagedProductSummariesResult.Products is not null && pagedProductSummariesResult.Products.Any())
            {
                _productSummaries = pagedProductSummariesResult.Products.ToList();
                _pagingData = pagedProductSummariesResult.PagingData;
                _productSummaryCount = _productSummaries.Count;
            }
        }
        else _errorMessage = pagedProductSummariesResult.ErrorMessage;
        _thinking = false;
    }


    protected override async Task OnAfterRenderAsync(bool isFirstRender)
    {
        if (isFirstRender)
        {
            await RefreshData();
            this.StateHasChanged();
        }
    }

    protected override void OnInitialized()
    {
        _thinking = true;
    }
}
