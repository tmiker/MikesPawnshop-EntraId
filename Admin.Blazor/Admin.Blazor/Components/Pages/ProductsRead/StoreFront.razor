@page "/store/storefront"
@layout StorefrontLayout
@rendermode InteractiveServer
@inject IPublicProductsReadHttpService _productReadSideHttpClient
@inject ICartsHttpService _cartsHttpClient
@inject NavigationManager Nav
@inject CascadingValueSource<CartData> cartDataSource
@attribute [Authorize(Policy = "IsAdminOrManager")]

<PageTitle>Storefront</PageTitle>

<div class="row mt-2">
    <div class="col-4">
        <h4><b>STORE FRONT</b></h4>
    </div>
    <div class="col-4 text-center">
        @if (_thinking)
        {
            <span class="loader-vertical-bars"></span>
        }
    </div>
    <div class="col-2">
        @if (_apiHealthCheckResult is null)
        {
            <a class="btn button-custom-primary-med form-control" @onclick="CartsApiHealthCheck">Carts API Health</a>
        }
        else
        {
            <a class="btn button-custom-primary-med  form-control" @onclick="ClearHealthCheckResult">Hide API Health</a>
        }
    </div>
    <div class="col-2">
        <a class="btn button-custom-warning-med form-control" @onclick="ToggleShowCart">@_cartButtonText</a>
    </div>
</div>

<div class="row mt-3">
    @if (!_showCart && SelectedProductId == 0)
    {
        <div class="col-3">
            @if (ProductsFetchTime.HasValue)
            {
                <h6 class="text-secondary"><i>Data Fetched: @ProductsFetchTime.Value</i></h6>
            }
        </div>
        <div class="col-3">
            @if (PageRenderTime.HasValue)
            {
                <h6 class="text-secondary"><i>Page Rendered: @PageRenderTime.Value</i></h6>
            }
        </div>
        <div class="col-3">
            <h6 class="text-secondary"><i>Current Time: @DateTime.Now</i></h6>
        </div>
    }
    else
    {
        <div class="col-9"></div>
    }
</div>

<ErrorComponent SuccessMessage="@_successMessage" ErrorMessage="@_errorMessage" ClearSuccessCallback="ClearSuccessMessage" ClearErrorCallback="ClearErrorMessage" />

@if (_apiHealthCheckResult is not null)
{
    <HealthCheckResult ApiHealthCheckResult="@_apiHealthCheckResult" />
}

<div class="row">
    <div class="col-12">
        @if (_showCart)
        {
            <CascadingValue Name="ShoppingCart" Value="@ShoppingCart">
                <StorefrontShoppingCart DetailCallback="Detail" CartItemCountChangedCallback="CartItemCountChanged" OrderSubmittedCallback="HandleOrderSubmitted" 
                    ErrorMessageCallback="HandleErrorMessage" SuccessMessageCallback="HandleSuccessMessage" />
            </CascadingValue>
        }
        else
        {
            @if (SelectedProductId > 0)
            {
                <CascadingValue Name="SelectedProductId" Value="@SelectedProductId">
                    <StorefrontProductDetail AddToCartWithQuantityCallback="AddToCartWithQuantity" BackToListCallback="BackToList" ErrorMessageCallback="HandleErrorMessage" SuccessMessageCallback="HandleSuccessMessage" />
                </CascadingValue>
            }
            else
            {
                <div class="card-header">
                    <div class="row mt-2">
                        <div class="col-2">
                            <label for="namefilter">Name Filter:</label>
                            <input class="bg-dark text-light form-control" id="namefilter" type="text" @bind="_nameFilter" @bind:after="GetProducts" />
                        </div>
                        <div class="col-2">
                            <label for="cat">Category Filter:</label>
                            <select class="bg-dark text-light form-select" id="cat" type="text" @bind="_categoryFilter" @bind:after="GetProducts">
                                <option value=""></option>
                                <option value="Astronomy">Astronomy</option>
                                <option value="Books">Books</option>
                                <option value="Computers">Computers</option>
                                <option value="Electronics">Electronics</option>
                                <option value="Music">Music</option>
                                <option value="Photography">Photography</option>
                                <option value="Sports">Sports</option>
                            </select>
                        </div>
                        <div class="col-2">
                            <label for="sort">Sort Column:</label>
                            <select class="bg-dark text-light form-select" id="sort" type="text" @bind="_sortColumn" @bind:after="GetProducts">
                                <option value=""></option>
                                <option value="Name">Name</option>
                                <option value="Price desc">Price Desc</option>
                                <option value="Price asc">Price Asc</option>
                            </select>
                        </div>
                        <div class="col-2">
                            <label for="pagesize">Page Size:</label>
                            <input class="bg-dark text-light form-control" id="pagesize" type="number" @bind="_pageSize" @bind:after="GetProducts" />
                        </div>
                        <div class="col-2">
                            <a class="btn button-custom-yellow-med form-control mt-4" @onclick="ClearFilters">Reset</a>
                        </div>
                        <div class="col-2">
                            <a class="btn button-custom-yellow-med form-control mt-4" @onclick="ToggleTableView">@_tableViewButtonText</a>
                        </div>
                    </div>
                </div>

                <CascadingValue Name="Products" Value="@Products">
                    <CascadingValue Name="PagingData" Value="@PagingData">
                        <CascadingValue Name="TableView" Value="@TableView">
                            <StorefrontProducts DetailCallback="Detail" AddToCartCallback="AddToCart" PageForwardCallback="PageForward"
                                                PageBackwardCallback="PageBackward" PageToCallback="PageTo" ErrorMessageCallback="HandleErrorMessage" SuccessMessageCallback="HandleSuccessMessage" />
                        </CascadingValue>
                    </CascadingValue>
                </CascadingValue>
            }
        }
    </div>
</div>

@code {

    [CascadingParameter(Name = "ShoppingCartData")]
    public CartData? MyCartData { get; set; }

    public List<ProductSummaryDTO>? Products { get; set; }
    public PaginationMetadata? PagingData { get; set; }
    public int SelectedProductId { get; set; } = 0;
    public ShoppingCartDTO? ShoppingCart { get; set; }
    private bool _showCart = false;
    private bool _thinking;

    public bool TableView = false;
    private string _tableViewButtonText => TableView ? "Card View" : "Table View";
    private void ToggleTableView() 
    {
        TableView = !TableView;
    }

    public DateTime? ProductsFetchTime { get; set; }
    public DateTime? PageRenderTime { get; set; }

    private HealthCheckResultDTO? _apiHealthCheckResult;
    private void ClearHealthCheckResult() => _apiHealthCheckResult = null;
    private async Task CartsApiHealthCheck()
    {
        _thinking = true;
        var result = await _cartsHttpClient.CheckHealthAsync();
        if (result.IsSuccess)
        {
            _apiHealthCheckResult = result.HealthCheckResultDTO;
        }
        else
        {
            _errorMessage = $"{result.ErrorMessage}";
        }
        _thinking = false;
    }

    private async Task CartItemCountChanged(int count)
    {
        MyCartData?.ItemCount = count;
        await cartDataSource.NotifyChangedAsync();
        _cartButtonText = MyCartData is null || MyCartData.ItemCount < 0 ? "Cart" : $"Cart ({MyCartData.ItemCount})";
    }

    private async Task PageForward()
    {
        if (PagingData is null || _pageNumber >= PagingData.TotalPageCount) return;
        _pageNumber = _pageNumber + 1;
        await GetProducts();
    }

    private async Task PageBackward()
    {
        if (_pageNumber <= 1) return;
        _pageNumber = _pageNumber - 1;
        await GetProducts();
    }

    private async Task PageTo(int page)
    {
        if (page == PagingData!.CurrentPage || page < 0 || page > PagingData.TotalPageCount) return;
        _pageNumber = page;
        await GetProducts();

    }

    private string? _nameFilter = null;
    private string? _categoryFilter = null;
    private string? _sortColumn = "Name";
    private int _pageNumber = 1;
    private int _pageSize = 4;

    // ERROR COMPONENT MESSAGING
    private string? _errorMessage;
    private string? _successMessage;
    private void ClearErrorMessage() => _errorMessage = null;
    private void ClearSuccessMessage() => _successMessage = null;
    private void ClearMessages()
    {
        _errorMessage = null;
        _successMessage = null;
    }
    private async Task HandleErrorMessage(string error) => _errorMessage = error;
    private async Task HandleSuccessMessage(string success) => _successMessage = success;

    private async Task ClearFilters()
    {
        _nameFilter = null;
        _categoryFilter = null;
        _sortColumn = "Name";
        _pageSize = 4;
        await GetProducts();
    }

    private void Detail(int id)
    {
        SelectedProductId = id;
        HideCart();
    }
    private void BackToList()
    {
        SelectedProductId = 0;
    }

    private string? _cartButtonText = "Cart";
    private async Task ShowCart()
    {
        if (ShoppingCart is null) await GetCart();
        _cartButtonText = "Continue Shopping";
        _showCart = true;
    }
    private void HideCart()
    {
        _cartButtonText = MyCartData is null || MyCartData.ItemCount < 0 ? "Cart" : $"Cart ({MyCartData.ItemCount})";   
        _showCart = false;
    }
    private async Task ToggleShowCart()
    {
        if (MyCartData is not null)
        {
            MyCartData.ShowCart = !MyCartData.ShowCart;         // changes the cascading parameter value but OnParametersSetAsync() is NOT called
            _previousCartDataShowCart = MyCartData.ShowCart;

            if (MyCartData.ShowCart) await ShowCart();
            else HideCart();
        }
    }

    private async Task HandleOrderSubmitted()
    {
        // Could handle this with component lifecycle methods instead of event callbacks from Checkout view, 
        // but then would not be maintaining the MyCartData objects state, only masking it.
        if (MyCartData is not null)
        {
            MyCartData.ShowCart = false;
            MyCartData.ItemCount = 0;
            _previousCartDataShowCart = false;
        }
        await cartDataSource.NotifyChangedAsync();
        HideCart();
    }

    // Add to cart with quantity from product detail component
    private async Task AddToCartWithQuantity(int quantity)
    {
        if (SelectedProductId == 0) return;

        ProductSummaryDTO? product = Products!.FirstOrDefault(p => p.Id == SelectedProductId);
        if (product is null) return;
        AddShoppingCartItemDTO addShoppingCartItemDTO = new AddShoppingCartItemDTO()
        {
            ProductId = product.Id,
            AggregateId = product.AggregateId.ToString(),
            Category = product.Category,
            Name = product.Name,
            Currency = product.Currency,
            Price = product.Price,
            UOM = product.UOM,
            Quantity = quantity,
            ThumbnailUrl = null
        };
        var result = await _cartsHttpClient.AddNewCartItemAsync(addShoppingCartItemDTO);
        if (result.IsSuccess)
        {
            await CartItemCountChanged(result.CartItemCount);
            // _cartButtonText = MyCartData is null || MyCartData.ItemCount < 0 ? "Cart" : $"Cart ({MyCartData.ItemCount})"; moved to CartItemCountChanged
            ShoppingCart = null; // will refresh when select cart view
        }
        else
        {
            _errorMessage = result.ErrorMessage;
        }
    }

    // Add to cart with quantity = 1 from product list component
    private async Task AddToCart(Guid productId)
    {
        ProductSummaryDTO? product = Products!.FirstOrDefault(p => p.AggregateId == productId);
        if (product is null) return;
        AddShoppingCartItemDTO addShoppingCartItemDTO = new AddShoppingCartItemDTO()
        {
            ProductId = product.Id,
            AggregateId = product.AggregateId.ToString(),
            Category = product.Category,
            Name = product.Name,
            Currency = product.Currency,
            Price = product.Price,
            UOM = product.UOM,
            Quantity = 1,
            ThumbnailUrl = null
        };
        var result = await _cartsHttpClient.AddNewCartItemAsync(addShoppingCartItemDTO);
        if (result.IsSuccess)
        {
            await CartItemCountChanged(result.CartItemCount);
            // _cartButtonText = MyCartData is null || MyCartData.ItemCount < 0 ? "Cart" : $"Cart ({MyCartData.ItemCount})"; 
            ShoppingCart = null; // will refresh when select cart view
        }
        else
        {
            _errorMessage = result.ErrorMessage;
        }
    }

    private async Task GetCart()
    {
        _thinking = true;
        var result = await _cartsHttpClient.GetShoppingCartAsync();
        if (result.IsSuccess)
        {
            ShoppingCart = result.ShoppingCart;
            if (ShoppingCart is not null) await CartItemCountChanged(ShoppingCart.Items.Count);
        }
        else _errorMessage = result.ErrorMessage;
        _thinking = false;
    }

    private async Task GetProducts()
    {
        _thinking = true;
        var result = await _productReadSideHttpClient.GetPagedAndFilteredProductSummariesAsync(_nameFilter, _categoryFilter, _sortColumn, _pageNumber, _pageSize);
        if (result.IsSuccess)
        {
            Products = result.Products?.ToList();
            PagingData = result.PagingData;
            ProductsFetchTime = result.FetchTime;
            PageRenderTime = DateTime.Now;
        }
        else
        {
            _errorMessage = result.ErrorMessage;
        }

        _thinking = false;
        this.StateHasChanged();
    }

    private bool _previousCartDataShowCart = false;

    protected override async Task OnParametersSetAsync()
    {
        if (MyCartData is not null && MyCartData.ShowCart != _previousCartDataShowCart)
        {
            _previousCartDataShowCart = MyCartData.ShowCart;
            if (MyCartData.ShowCart) await ShowCart();
            else HideCart();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _cartButtonText = MyCartData is null || MyCartData.ItemCount < 0 ? "Cart" : $"Cart ({MyCartData.ItemCount})";   
            await GetProducts();
            StateHasChanged();
        }
    }

    protected override void OnInitialized()
    {
        _thinking = true;
    }
}
