@if (_thinking)
{
    <div class="mx-auto text-center mb-3 mt-3">
        <div class="spinner-border text-success role-status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}

@code {
    [Inject]
    public IConfiguration Configuration { get; set; } = default!;
    [Inject]
    public static HttpClient Client { get; set; } = new HttpClient();
    [Inject]
    public IWebHostEnvironment WebHostEnv { get; set; } = default!;

    private bool _thinking = false;
    private string? _accountsApiResponse;
    private string? _cartsApiResponse;
    private string? _ordersApiResponse;
    private string? _productsReadApiResponse;
    private string? _proeductsWriteApiResponse;
    private string? _consumerClientResponse;
    private string? _adminClientResponse;
    private string? _yarpProxyResponse;
    private string? _pingAllResult;
    private string? _consumerBaseUrl;

    private async Task PingAccountsAPI()
    {
        _thinking = true;
        var baseUrl = Configuration["AccountsApiBaseURL"];
        try
        {
            using (var response = await Client.GetAsync($"{baseUrl}"))
            {
                if (response.IsSuccessStatusCode)
                {
                    _accountsApiResponse = await response.Content.ReadAsStringAsync();
                }
                else
                {
                    _accountsApiResponse = "Failed to reach Accounts API.";
                }
                _thinking = false;
            }
        }
        catch (Exception ex)
        {
            _accountsApiResponse = $"Accounts API Error: {ex.Message}";
            _thinking = false;
        }
    }
    private void ClearAccountsApiResponse() => _accountsApiResponse = null;

    private async Task PingCartsAPI()
    {
        _thinking = true;
        var baseUrl = Configuration["CartsApiBaseURL"];
        try
        {
            using (var response = await Client.GetAsync($"{baseUrl}"))
            {
                if (response.IsSuccessStatusCode)
                {
                    _cartsApiResponse = await response.Content.ReadAsStringAsync();
                }
                else
                {
                    _cartsApiResponse = "Failed to reach Carts API.";
                }
                _thinking = false;
            }
        }
        catch (Exception ex)
        {
            _cartsApiResponse = $"Carts API Error: {ex.Message}";
            _thinking = false;
        }
    }
    private void ClearCartsApiResponse() => _cartsApiResponse = null;

    private async Task PingOrdersAPI()
    {
        _thinking = true;
        var baseUrl = Configuration["OrdersApiBaseURL"];
        try
        {
            using (var response = await Client.GetAsync($"{baseUrl}"))
            {
                if (response.IsSuccessStatusCode)
                {
                    _ordersApiResponse = await response.Content.ReadAsStringAsync();
                }
                else
                {
                    _ordersApiResponse = "Failed to reach Orders API.";
                }
                _thinking = false;
            }
        }
        catch (Exception ex)
        {
            _ordersApiResponse = $"Orders API Error: {ex.Message}";
            _thinking = false;
        }
    }
    private void ClearOrdersApiResponse() => _ordersApiResponse = null;

    private async Task PingProductsReadAPI()
    {
        _thinking = true;
        var baseUrl = Configuration["ProductsReadApiBaseURL"];
        try
        {
            using (var response = await Client.GetAsync($"{baseUrl}"))
            {
                if (response.IsSuccessStatusCode)
                {
                    _productsReadApiResponse = await response.Content.ReadAsStringAsync();
                }
                else
                {
                    _productsReadApiResponse = "Failed to reach Products Read API.";
                }
                _thinking = false;
            }
        }
        catch (Exception ex)
        {
            _productsReadApiResponse = $"Products Read API Error: {ex.Message}";
            _thinking = false;
        }
    }
    private void ClearProductsReadApiResponse() => _productsReadApiResponse = null;

    private async Task PingProductsWriteAPI()
    {
        _thinking = true;
        var baseUrl = Configuration["ProductsWriteApiBaseURL"];
        try
        {
            using (var response = await Client.GetAsync($"{baseUrl}"))
            {
                if (response.IsSuccessStatusCode)
                {
                    _proeductsWriteApiResponse = await response.Content.ReadAsStringAsync();
                }
                else
                {
                    _proeductsWriteApiResponse = "Failed to reach Products Write API.";
                }
                _thinking = false;
            }
        }
        catch (Exception ex)
        {
            _proeductsWriteApiResponse = $"Products Write API Error: {ex.Message}";
            _thinking = false;
        }
    }
    private void ClearProductsWriteApiResponse() => _proeductsWriteApiResponse = null;

    private async Task PingAdminClient()
    {
        _thinking = true;
        var baseUrl = Configuration["BlazorAdminClientBaseURL"];
        try
        {
            using (var response = await Client.GetAsync($"{baseUrl}"))
            {
                if (response.IsSuccessStatusCode)
                {
                    _adminClientResponse = await response.Content.ReadAsStringAsync();
                }
                else
                {
                    _adminClientResponse = "Failed to reach Blazor Admin Client.";
                }
                _thinking = false;
            }
        }
        catch (Exception ex)
        {
            _adminClientResponse = $"Admin Client Error: {ex.Message}";
            _thinking = false;
        }
    }
    private void ClearAdminClientResponse() => _adminClientResponse = null;

    private async Task PingYarpProxy()
    {
        _thinking = true;
        var baseUrl = Configuration["YarpProxyBaseURL"];
        try
        {
            using (var response = await Client.GetAsync($"{baseUrl}"))
            {
                if (response.IsSuccessStatusCode)
                {
                    _yarpProxyResponse = await response.Content.ReadAsStringAsync();
                }
                else
                {
                    _yarpProxyResponse = "Failed to reach YARP Proxy.";
                }
                _thinking = false;
            }
        }
        catch (Exception ex)
        {
            _yarpProxyResponse = $"YARP Proxy Error: {ex.Message}";
            _thinking = false;
        }
    }
    private void ClearYarpProxyResponse() => _yarpProxyResponse = null;

    private async Task PingConsumerClient()
    {
        _thinking = true;
        var baseUrl = Configuration["BlazorConsumerClientBaseURL"];
        if (WebHostEnv.EnvironmentName == "Development")
        {
            baseUrl = "https://localhost:7217";
        }
        var pingUrl = $"{baseUrl}/ping";
        try
        {
            using (var response = await Client.GetAsync($"{pingUrl}"))
            {
                if (response.IsSuccessStatusCode)
                {
                    _consumerClientResponse = await response.Content.ReadAsStringAsync();
                }
                else
                {
                    _consumerClientResponse = "Failed to reach Blazor Consumer Client.";
                }
                _thinking = false;
            }
        }
        catch (Exception ex)
        {
            _consumerClientResponse = $"Consumer Client Error: {ex.Message}";
            _thinking = false;
        }
    }
    private void ClearConsumerClientResponse() => _consumerClientResponse = null;

    private async Task PingAllPawnshopEndpoints()
    {
        _thinking = true;
        var tasks = new List<Task>
        {
            PingAccountsAPI(),
            PingCartsAPI(),
            PingOrdersAPI(),
            PingProductsReadAPI(),
            PingProductsWriteAPI(),
            PingYarpProxy(),
            PingConsumerClient()
        };
        await Task.WhenAll(tasks);
        _pingAllResult = "Finished pinging all endpoints.";
        _thinking = false;
    }
    private void ClearPingAllPawnshopEndpointsResult() 
    {
        _pingAllResult = null;
        _accountsApiResponse = null;
        _cartsApiResponse = null;
        _ordersApiResponse = null;
        _productsReadApiResponse = null;
        _proeductsWriteApiResponse = null;
        _consumerClientResponse = null;
        // _adminClientResponse = null;
        _yarpProxyResponse = null;
        _pingAllResult = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _consumerBaseUrl = Configuration["BlazorConsumerClientBaseURL"];
            this.StateHasChanged();
        }
    }
}
