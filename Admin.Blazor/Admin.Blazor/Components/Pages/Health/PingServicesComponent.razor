<div class="row mt-4">
    <div class="col-3">
        <a class="btn button-custom-info-med form-control" @onclick="PingYarpProxy">Ping YARP Proxy</a>
    </div>
    <div class="col-7">
        <input type="text" class="bg-dark text-light form-control" @bind-value=_yarpProxyResponse" />
