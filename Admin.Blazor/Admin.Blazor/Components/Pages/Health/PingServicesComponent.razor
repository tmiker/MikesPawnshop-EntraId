@page "/ping-services"
@rendermode InteractiveServer

<PageTitle>Pawnshop Services</PageTitle>

<h3 class="mt-2">Pawnshop Services</h3>

<div class="row mt-4">
    <div class="col-5">
        <h6 class="mt-2">Open Pawnshop Consumer Client Application (in a new window):</h6>
    </div>
    @if (!string.IsNullOrEmpty(_consumerBaseUrl))
    {
        <div class="col-3">
            <a class="btn button-custom-info-med form-control" href="@_consumerBaseUrl" target="_blank">Consumer Client</a>
        </div>
    }
    else
    {
        <div class="col-3">
            <h6><i>Missing Client URL</i></h6>
        </div>
    }
</div>

<div class="row mt-4">
    <div class="col-3">
        <a class="btn button-custom-info-med form-control" @onclick="PingAccountsAPI">Ping Accounts API</a>
    </div>
    <div class="col-7">
        <input type="text" class="bg-dark text-light form-control" @bind-value=_accountsApiResponse" />
    </div>
    @if (!string.IsNullOrEmpty(_accountsApiResponse))
    {
        <div class="col-2">
            <a class="btn btn-secondary form-control" @onclick=ClearAccountsApiResponse>Clear</a>
        </div>
    }
</div>

<div class="row mt-4">
    <div class="col-3">
        <a class="btn button-custom-info-med form-control" @onclick="PingCartsAPI">Ping Carts API</a>
