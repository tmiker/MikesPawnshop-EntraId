@page "/account/myAccount"
@rendermode InteractiveServer
@inject IAccountsHttpService _accountHttpService
@attribute [Authorize(Policy = "IsAdminOrManager")]

<div class="row mt-2">
    <div class="col-10">
        <h4><b>My Account</b></h4>
    </div>
    @if (_accountInfo is null)
    {
        <div class="col-2">
            <a class="btn btn-success form-control" @onclick="AddAccount">Add Account Info</a>
        </div>
    }
</div>

@* @if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="row mt-2">
        <div class="col-10">
            <h5 class="text-danger"><b>Error:</b></h5>
        </div>
        <div class="col-2">
            <a class="btn btn-warning form-control" @onclick="ClearErrorMessage">Clear Errors</a>
        </div>
    </div>
    <div class="row mt-2">
        <div class="col-12 text-center">
            <textarea rows="2" class="bg-dark text-danger form-control">@_errorMessage</textarea>
        </div>
    </div>
} *@

@if (_accountInfo is not null)
{
    <br/>
    <div class="form-group row">
        <div class="col-3 offset-1">
            <label for="id">Account Id:</label>
        </div>
        <div class="col-7">
            <InputText inert class="bg-dark text-light form-control" id="accountId" @bind-Value="@_accountInfo.AccountId" />
        </div>
    </div>

    <div class="form-group row">
        <div class="col-3 offset-1">
            <label for="first">First:</label>
        </div>
        <div class="col-7">
            <InputText inert class="bg-dark text-light form-control " id="first" @bind-Value="@_accountInfo.FirstName" />
        </div>
    </div>
    <div class="form-group row">
        <div class="col-3 offset-1">
            <label for="last">Last:</label>
        </div>
        <div class="col-7">
            <InputText inert class="bg-dark text-light form-control" id="last" @bind-Value="@_accountInfo.LastName" />
        </div>
    </div>

    <div class="form-group row">
        <div class="col-3 offset-1">
            <label for="email">Email:</label>
        </div>
        <div class="col-7">
            <InputText inert class="bg-dark text-light form-control " id="email" @bind-Value="@_accountInfo.Email" />
        </div>
    </div>
    <div class="form-group row">
        <div class="col-3 offset-1">
            <label for="phone">Phone:</label>
        </div>
        <div class="col-7">
            <InputText inert class="bg-dark text-light form-control" id="phone" @bind-Value="@_accountInfo.PhoneNumber" />
        </div>
    </div>
    <div class="form-group row">
        <div class="col-3 offset-1">
            <label for="status">Status:</label>
        </div>
        <div class="col-7">
            <InputText inert class="bg-dark text-light form-control " id="status" @bind-Value="@_accountInfo.AccountStatus" />
        </div>
    </div>
    <div class="form-group row">
        <div class="col-3 offset-1">
            <label for="credit">Credit Limit:</label>
        </div>
        <div class="col-7">
            <InputNumber inert class="bg-dark text-light form-control " id="credit" @bind-Value="@_accountInfo.CreditLimit" />
        </div>
    </div>

    <div class="row mt-4 text-center">
        <div class="col-12">
            <h4>My Addresses</h4>

            @if (_accountInfo?.Addresses != null && _accountInfo.Addresses.Any())
            {
                <table class="table table-dark table-bordered">
                    <thead>
                        <tr>
                            <th>Street 1</th>
                            <th>Street 2</th>
                            <th>City</th>
                            <th>State</th>
                            <th>Zipcode</th>
                            <th>Shipping</th>
                            <th>Billing</th>

                            <th colspan="3"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var address in _accountInfo.Addresses)    // System.NullReferenceException: 'Object reference not set to an instance of an object.'  address was null.
                        {
                            <tr>
                                <td>@address.Street1</td>
                                <td>@address.Street2</td>
                                <td>@address.City</td>
                                <td>@address.State</td>
                                <td>@address.PostalCode</td>
                                <td class="text-center">
                                    @if (address.IsPrimaryShipping)
                                    {
                                        <p class="text-success-alt m-0 p-0"><b>&#10004</b></p>
                                    }
                                </td>

                                <td class="text-center">
                                    @if (address.IsPrimaryBilling)
                                    {
                                        <p class="text-success-alt m-0 p-0"><b>&#10004</b></p>
                                    }
                                </td>
                                <td colspan="1">
                                    <a class="btn btn-primary form-control" style="width:100px;">Detail</a>
                                </td>
                                <td colspan="1">
                                    <a class="btn btn-success form-control" style="width:100px;">Edit</a>
                                </td>
                                <td colspan="1">
                                    <a class="btn btn-danger form-control" style="width:100px;">Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="row mt-2">
                    <div class="col-4 offset-4 text-center">
                        <a class="btn btn-success form-control" @onclick="AddAddress">Add Address</a>
                    </div>
                </div>
            }

        </div>
    </div>
}
else
{
    <div class="row mt-2">
        <div class="col-4 offset-4 text-center">
            <h4><b><i>Please add your account information!</i></b></h4>
        </div>
    </div>
}

@if (_apiHealthCheckResult is null)
{
    <br />
    <div class="row mt-2">
        <div class="col-3">
            <a class="btn btn-primary form-control" @onclick="ApiHealthCheck">Accounts API Health</a>
        </div>
    </div>
}
else
{
    <br />
    <div class="row mt-2">
        <div class="col-3">
            <a class="btn btn-primary form-control" @onclick="ClearHealthCheckResult">Clear API Health</a>
        </div>
    </div>
    <HealthCheckResult ApiHealthCheckResult="@_apiHealthCheckResult" />
}

@* @if (string.IsNullOrWhiteSpace(_apiHealthCheckResult))
{
    <div class="row mt-2">
        <div class="col-2">
            <a class="btn btn-primary form-control" @onclick="AccountsApiHealthCheck">Check API Health</a>
        </div>
    </div>
}
else
{
    <br />
    <div class="row mt-2">
        <div class="col-10">
            <h5><b>Health Check Result:</b></h5>
        </div>
        <div class="col-2">
            <a class="btn btn-primary form-control" @onclick="ClearHealthCheckResult">Clear Result</a>
        </div>
    </div>
    <div class="row mt-2">
        <div class="col-12 text-center">
            <textarea rows="2" class="bg-dark text-light form-control">@_apiHealthCheckResult</textarea>
        </div>
    </div>
} *@

@if (_thinking)
{
    <div class="mx-auto text-center mb-3 mt-3">
        <div class="spinner-border text-yellow-alt role-status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
@if (_addAccountDTO is not null)
{
    <AddAccountModal AccountToAdd="@_addAccountDTO" Title="Add Account" Submit="SubmitAddAccount" Cancel="CancelAddAccount" />
}
@if (_addAddressDTO != null)
{
    <AddAddressModal Title="Add New Address" AddressToAdd="@_addAddressDTO" Cancel="CancelAddAddress" Submit="SubmitAddAddress" />
}

@code {

    private AccountDTO? _accountInfo;
    private bool _thinking = false;
    private string? _errorMessage;
    private void ClearErrorMessage() => _errorMessage = null;

    private HealthCheckResultDTO? _apiHealthCheckResult;
    private void ClearHealthCheckResult() => _apiHealthCheckResult = null;
    private async Task ApiHealthCheck()
    {
        var result = await _accountHttpService.CheckHealthAsync();
        if (result.IsSuccess)
        {
            _apiHealthCheckResult = result.HealthCheckResultDTO;
        }
        else
        {
            _errorMessage = $"{result.ErrorMessage}";
        }
    }

    private AddAccountDTO? _addAccountDTO;
    private void AddAccount() => _addAccountDTO = new AddAccountDTO();
    private void CancelAddAccount() => _addAccountDTO = null;
    private async Task SubmitAddAccount()
    {
        _errorMessage = null;
        if (_addAccountDTO is null)
        {
            _errorMessage = $"A new account object was not provided.";
            return;
        }
        else
        {
            var result = await _accountHttpService.CreateAccountAsync(_addAccountDTO!);
            if (result.IsSuccess) await ReloadAsync();
        }
        _addAccountDTO = null;
    }

    private AddAddressDTO? _addAddressDTO;
    private void AddAddress() => _addAddressDTO = new AddAddressDTO();
    private void CancelAddAddress() => _addAddressDTO = null;
    private async Task SubmitAddAddress()
    {
        if (_addAddressDTO is null)
        {
            _errorMessage = $"A new address object was not provided.";
            return;
        }
        else
        {
            var result = await _accountHttpService.AddAddressAsync(_addAddressDTO);
            _addAddressDTO = null;
            if (result.IsSuccess) await ReloadAsync();
        }
    }

    private async Task ReloadAsync()
    {
        var result = await _accountHttpService.GetAccountAsync();
        if (result.IsSuccess)
        {
            _accountInfo = result.Account;
        }
        else
        {
            _errorMessage = result.ErrorMessage;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ReloadAsync();
            this.StateHasChanged();
        }
    }
}
