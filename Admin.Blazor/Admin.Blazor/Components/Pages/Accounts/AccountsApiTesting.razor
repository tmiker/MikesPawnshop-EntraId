@page "/dev/accounts-api-testing"
@rendermode InteractiveServer
@inject IAccountsHttpService _accountHttpService
@inject IToastrService _toastr
@attribute [AllowAnonymous]

<h3>Accounts Api Testing</h3>

<div class="row mt-4">
    <div class="col-3">
        <a class="btn btn-success form-control" @onclick="CreateTestAccountAsync">Create Test Account</a>
    </div>
    <div class="col-3">
        <a class="btn btn-warning form-control" @onclick="GetTestAccountAsync">Get Test Account</a>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">
        <ErrorComponent ErrorMessage="@_errorMessage" SuccessMessage="@_successMessage" ClearErrorCallback="ClearErrorMessage" ClearSuccessCallback="ClearSuccessMessage" />
    </div>
</div>

@if (_account is not null)
{
    <br />
    <div class="form-group row mt-4">
        <div class="col-3 offset-1">
            <label for="id">Account Id:</label>
        </div>
        <div class="col-7">
            <InputText inert class="bg-dark text-light form-control" id="accountId" @bind-Value="@_account.AccountId" />
        </div>
    </div>

    <div class="form-group row">
        <div class="col-3 offset-1">
            <label for="first">First:</label>
        </div>
        <div class="col-7">
            <InputText inert class="bg-dark text-light form-control " id="first" @bind-Value="@_account.FirstName" />
        </div>
    </div>
    <div class="form-group row">
        <div class="col-3 offset-1">
            <label for="last">Last:</label>
        </div>
        <div class="col-7">
            <InputText inert class="bg-dark text-light form-control" id="last" @bind-Value="@_account.LastName" />
        </div>
    </div>

    <div class="form-group row">
        <div class="col-3 offset-1">
            <label for="email">Email:</label>
        </div>
        <div class="col-7">
            <InputText inert class="bg-dark text-light form-control " id="email" @bind-Value="@_account.Email" />
        </div>
    </div>
    <div class="form-group row">
        <div class="col-3 offset-1">
            <label for="phone">Phone:</label>
        </div>
        <div class="col-7">
            <InputText inert class="bg-dark text-light form-control" id="phone" @bind-Value="@_account.PhoneNumber" />
        </div>
    </div>
    <div class="form-group row">
        <div class="col-3 offset-1">
            <label for="status">Status:</label>
        </div>
        <div class="col-7">
            <InputText inert class="bg-dark text-light form-control " id="status" @bind-Value="@_account.AccountStatus" />
        </div>
    </div>
    <div class="form-group row">
        <div class="col-3 offset-1">
            <label for="credit">Credit Limit:</label>
        </div>
        <div class="col-7">
            <InputNumber inert class="bg-dark text-light form-control " id="credit" @bind-Value="@_account.CreditLimit" />
        </div>
    </div>

    <div class="row mt-4 text-center">
        <div class="col-12">
            <h4>My Addresses</h4>

            @if (_account?.Addresses != null && _account.Addresses.Any())
            {
                <table class="table table-dark table-bordered">
                    <thead>
                        <tr>
                            <th>Street 1</th>
                            <th>Street 2</th>
                            <th>City</th>
                            <th>State</th>
                            <th>Zipcode</th>
                            <th>Shipping</th>
                            <th>Billing</th>

                            <th colspan="3"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var address in _account.Addresses)    
                        {
                            <tr>
                                <td>@address.Street1</td>
                                <td>@address.Street2</td>
                                <td>@address.City</td>
                                <td>@address.State</td>
                                <td>@address.PostalCode</td>
                                <td class="text-center">
                                    @if (address.IsPrimaryShipping)
                                    {
                                        <p class="text-success-alt m-0 p-0"><b>&#10004</b></p>
                                    }
                                </td>

                                <td class="text-center">
                                    @if (address.IsPrimaryBilling)
                                    {
                                        <p class="text-success-alt m-0 p-0"><b>&#10004</b></p>
                                    }
                                </td>
                                <td colspan="1">
                                    <a class="btn btn-primary form-control" style="width:100px;">Detail</a>
                                </td>
                                <td colspan="1">
                                    <a class="btn btn-success form-control" style="width:100px;">Edit</a>
                                </td>
                                <td colspan="1">
                                    <a class="btn btn-danger form-control" style="width:100px;">Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="row mt-2">
                    <div class="col-4 offset-4 text-center">
                        <h5 class="text-info-alt"><i>No addresses found.</i></h5>
                    </div>
                </div>
            }

        </div>
    </div>
}

@code {

    private string? _createAccountResult;
    private AccountDTO? _account;
    private bool _thinking = false;
    private string? _successMessage;
    private string? _errorMessage;
    private void ClearSuccessMessage() => _successMessage = null;
    private void ClearErrorMessage() => _errorMessage = null;

    private async Task CreateTestAccountAsync()
    {
        _thinking = true;
        var result = await _accountHttpService.CreateTestAccountAsync();
        if (result.IsSuccess)
        {
            await _toastr.ShowToastrSuccess($"Test account created successfully");
            _successMessage = $"Test account created successfully";
        }
        else
        {
            await _toastr.ShowToastrError($"Failed to create test account: {result.ErrorMessage}");
            _errorMessage = $"Failed to create test account: {result.ErrorMessage}";
        }
        _thinking = false;
    }

    private async Task GetTestAccountAsync()
    {
        _thinking = true;
        var result = await _accountHttpService.GetTestAccountAsync();
        if (result.IsSuccess)
        {
            _account = result.Account;
            await _toastr.ShowToastrSuccess($"Test account retrieved successfully");
            _successMessage = $"Test account retrieved successfully";
        }
        else
        {
            await _toastr.ShowToastrError($"Failed to retrieve test account: {result.ErrorMessage}");
            _errorMessage = $"Failed to retrieve test account: {result.ErrorMessage}";
        }
        _thinking = false;
    }
}
