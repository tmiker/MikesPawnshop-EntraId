@page "/ping-services-2"
@inject IAzureServicesHttpClient AzureServicesClient
@rendermode InteractiveServer

<PageTitle>Pawnshop Services</PageTitle>


<div class="row mt-4">
    <div class="col-10">
        <h6 class="mt-2">Check Pawnshop API Resource and Reverse Proxy Status</h6>
    </div>
    <div class="col-2">
        <a class="btn button-custom-success-med form-control" @onclick="PingAllPawnshopEndpoints">Ping All</a>
    </div>
</div>

@if (_resourceDTOs is not null)
{
    <table class="table table-bordered table-dark text-center mt-4">
        <thead>
            <tr>
                <th>Name</th>
                <th>API Status</th>
                <th>DB Status</th>
                <th>Results</th>
                <th>Progress</th>
                <th></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var resource in _resourceDTOs)
            {
                <tr>
                    <td>@resource.ResourceName</td>
                    <td>@if (resource.ServiceAvailable)
                        {
                            <p class="text-success-alt m-0">X</p>
                        }
                    </td>
                    <td>@if (resource.DatabaseAvailable)
                        {
                            <p class="text-success-alt m-0">X</p>
                        }
                    </td>
                    <td>@resource.Message</td>
                    <td>@resource.Progress</td>
                    <td></td>
                    <td></td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="row mt-4">
    <div class="col-2">
        <a class="btn button-custom-primary-med form-control" @onclick="PingAccountsAPI">Ping Accounts</a>
    </div>
    <div class="col-2">
        <a class="btn button-custom-primary-med form-control" @onclick="PingCartsAPI">Ping Carts</a>
    </div>
    <div class="col-2">
        <a class="btn button-custom-primary-med form-control" @onclick="PingOrdersAPI">Ping Orders</a>
    </div>
    <div class="col-2">
        <a class="btn button-custom-primary-med form-control" @onclick="PingProductsReadAPI">Ping Products Read</a>
    </div>
    <div class="col-2">
        <a class="btn button-custom-primary-med form-control" @onclick="PingProductsWriteAPI">Ping Products Write</a>
    </div>
    <div class="col-2">
        <a class="btn button-custom-primary-med form-control" @onclick="PingYarpProxy">Ping YARP Proxy</a>
    </div>
</div>

