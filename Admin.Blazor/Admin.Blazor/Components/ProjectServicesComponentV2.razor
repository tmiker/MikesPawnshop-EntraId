    private async Task PingYarpProxy()
    {
        _thinking = true;
        _yarpResourceDTO.Reset();
        _yarpResourceDTO.Progress = "...pinging YARP Proxy...";
        _yarpResourceDTO.DatabaseAvailable = true;
        var result = await AzureServicesClient.CheckYarpProxyAsync();
        if (result.IsSuccess)
        {
            _yarpResourceDTO.ServiceAvailable = true;
            _yarpResourceDTO.Message = result.Result;
        }
        else
        {
            _yarpResourceDTO.ServiceAvailable = false;
            _yarpResourceDTO.Message = $"YARP Proxy unavailable. Please try again.";
            _yarpResourceDTO.DatabaseAvailable = false;
        }
        _yarpResourceDTO.Progress = "Complete";
        _thinking = false;
    }
    // private void ClearYarpProxyResponse() => _yarpProxyResponse = null;

    private async Task PingAllPawnshopEndpoints()
    {
        _allThinking = true;
        var tasks = new List<Task>
        {
            PingAccountsAPI(),
            PingCartsAPI(),
            PingOrdersAPI(),
            PingProductsReadAPI(),
            PingProductsWriteAPI(),
            PingYarpProxy()
        };
        await Task.WhenAll(tasks);

        _allThinking = false;
    }

    protected override void OnInitialized()
    {
        _resourceDTOs = new List<ResourceStatusDTO>()
        {
            _accountsApiResourceDTO, _cartsApiResourceDTO, _ordersApiResourceDTO, 
