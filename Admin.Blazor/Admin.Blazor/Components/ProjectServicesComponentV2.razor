@page "/ping-services-2"
@inject IAzureServicesHttpClient AzureServicesClient
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>Pawnshop Services</PageTitle>


<div class="row mt-4">
    @* <div class="col-4">
        <h6 class="mt-2">Check Pawnshop API Resources and Reverse Proxy Status</h6>
    </div>
    <div class="col-2">
        <a class="btn button-custom-success-med form-control" @onclick="PingAllPawnshopEndpoints">Ping All</a>
    </div> *@
    <div class="col-4">
        <h5>Check Mike's Pawnshop Status</h5>
    </div>
    <div class="col-2">
        <label class="text-info-alt">
            <input type="checkbox" id="domainInfo" class="form-check-input bg-dark border-secondary toolbar-checkbox-custom "
                   @bind-value="@_checkMongoDatabases" checked="@_checkMongoDatabases" />
            Check Mongo
        </label>
    </div>
    <div class="col-2">
        <label class="text-info-alt">
            <input type="checkbox" id="domainInfo" class="form-check-input bg-dark border-secondary toolbar-checkbox-custom "
                   @bind-value="@_checkSqlDatabases" checked="@_checkSqlDatabases" />
            Check SQL
        </label>
    </div>
    <div class="col-2 offset-2">
        @if (_accountsThinking || _cartsThinking || _ordersThinking || _productsReadThinking || _productsWriteThinking || _yarpThinking)
        {
            <a class="btn button-custom-danger-med form-control mb-4" @onclick="PingAllPawnshopEndpoints">Cancel</a>
        }
        else
        {
            <a class="btn button-custom-success-med form-control mb-4" @onclick="PingAllPawnshopEndpoints">Ping All</a>
        }
    </div>
</div>

@if (_resourceDTOs is not null)
{
    <table class="table table-bordered table-dark text-center mt-4">
        <thead>
            <tr>
                <th>Resource Name</th>
                <th>API Status</th>
                <th>DB Status</th>
                <th>Results</th>
                <th>Progress</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var resource in _resourceDTOs)
            {
                <tr>
                    <td>@resource.ResourceName</td>
                    <td>@if (resource.ServiceAvailable)
                        {
                            <p class="text-success-alt m-0">&#10004</p>
                        }
                    </td>
                    <td>@if (resource.DatabaseAvailable)
                        {
                            <p class="text-success-alt m-0">&#10004</p>
                        }
                    </td>
                    <td>@resource.Message</td>
                    <td>@resource.Progress</td>
                    @* <td>
                        <a class="btn button-custom-table-primary" @onclick="(() => PingResource(resource.ResourceName))">Ping</a>
                    </td> *@
                    <td>
                        @if (resource.Progress is not null && resource.Progress.Contains("Database"))
                        {
                            <a class="btn button-custom-table-danger" @onclick="CancelOperationAsync">Cancel</a>
                        }
                        else
                        {
                            <a class="btn button-custom-table-primary" @onclick="(() => PingResource(resource.ResourceName))">Ping</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="row mt-4">
    <div class="col-2">
        <a class="btn button-custom-primary-med form-control" @onclick="PingYarpProxy">Ping YARP Proxy</a>
    </div>
    <div class="col-8">
        <input type="text" class="bg-dark text-light form-control" @bind-value="_yarpProxyResponse" />
    </div>
    @if (!string.IsNullOrEmpty(_yarpProxyResponse))
    {
        <div class="col-2">
            <a class="btn button-custom-secondary-med form-control" @onclick="ClearYarpProxyResponse">Clear</a>
        </div>
    }
</div>

@if (_accountsThinking || _cartsThinking || _ordersThinking || _productsReadThinking || _productsWriteThinking || _yarpThinking)
{
    <div class="mx-auto text-center mb-3 mt-3">
        <div class="spinner-border text-success role-status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}

@code {
    private ResourceStatusDTO _accountsApiResourceDTO = new ResourceStatusDTO { ResourceName = "Accounts API" };
    private ResourceStatusDTO _cartsApiResourceDTO = new ResourceStatusDTO { ResourceName = "Carts API" };
    private ResourceStatusDTO _ordersApiResourceDTO = new ResourceStatusDTO { ResourceName = "Orders API" };
    private ResourceStatusDTO _productsReadApiResourceDTO = new ResourceStatusDTO { ResourceName = "Products Read API" };
    private ResourceStatusDTO _productsWriteApiResourceDTO = new ResourceStatusDTO { ResourceName = "Products Write API" };
    // private ResourceStatusDTO _yarpResourceDTO = new ResourceStatusDTO { ResourceName = "Yarp Proxy" };
    private List<ResourceStatusDTO>? _resourceDTOs;

    private string? _yarpProxyResponse;
    private string? _consumerClientResponse;
    private bool _yarpThinking = false;
    private bool _accountsThinking = false;
    private bool _cartsThinking = false;
    private bool _ordersThinking = false;
    private bool _productsWriteThinking = false;
    private bool _productsReadThinking = false;
    private bool _checkMongoDatabases = true;
    private bool _checkSqlDatabases = true;

    private CancellationTokenSource? _cancellationTokenSource = new CancellationTokenSource();
    private async Task CancelOperationAsync() => await _cancellationTokenSource!.CancelAsync();

    private async Task PingResource(string? resourceName)
    {
        if (string.IsNullOrWhiteSpace(resourceName)) return;
        switch (resourceName)
        {
            case "Accounts API":
                await PingAccountsAPI();
                break;
            case "Carts API":
                await PingCartsAPI();
                break;
            case "Orders API":
                await PingOrdersAPI();
                break;
            case "Products Read API":
                await PingProductsReadAPI();
                break;
            case "Products Write API":
                await PingProductsWriteAPI();
                break;
            default: return;
        }
    }

    private async Task PingAccountsAPI()
    {
        _accountsThinking = true;
        _accountsApiResourceDTO.Reset();
        _accountsApiResourceDTO.Progress = "...checking Accounts API...";
        var result = await AzureServicesClient.CheckAccountsApiAsync();
        if (result.IsSuccess)
        {
            _accountsApiResourceDTO.ServiceAvailable = true;
            _accountsApiResourceDTO.Message = "API success";   // result.Result;
            // check Mongo Database
            if (_checkMongoDatabases)
            {
                _accountsApiResourceDTO.Progress = "...checking Accounts Database...";
                var mongoResult = await AzureServicesClient.CheckAccountsMongoAsync();
                if (mongoResult.IsSuccess)
                {
                    _accountsApiResourceDTO.DatabaseAvailable = true;
                    _accountsApiResourceDTO.Message = $"{result.Result}";
                }
                else
                {
                    _accountsApiResourceDTO.DatabaseAvailable = false;
                    _accountsApiResourceDTO.Message = $"Database error. Please try again.";
                }
            }
        }
        else
        {
            _accountsApiResourceDTO.ServiceAvailable = false;
            _accountsApiResourceDTO.Message = $"Accounts API unavailable. Please try again.";
            _accountsApiResourceDTO.DatabaseAvailable = false;
        }
        _accountsApiResourceDTO.Progress = "Complete";
        _accountsThinking = false;
    }

    private async Task PingCartsAPI()
    {
        _cartsThinking = true;
        _cartsApiResourceDTO.Reset();
        _cartsApiResourceDTO.Progress = "...checking Carts API...";
        var result = await AzureServicesClient.CheckCartsApiAsync();
        if (result.IsSuccess)
        {
            _cartsApiResourceDTO.ServiceAvailable = true;
            _cartsApiResourceDTO.Message = "API success";   // result.Result;
            if (_checkMongoDatabases)
            {
                // check Mongo Database
                _cartsApiResourceDTO.Progress = "...checking Carts Database...";
                var mongoResult = await AzureServicesClient.CheckCartsMongoAsync();
                if (mongoResult.IsSuccess)
                {
                    _cartsApiResourceDTO.DatabaseAvailable = true;
                    _cartsApiResourceDTO.Message = $"{result.Result}";
                }
                else
                {
                    _cartsApiResourceDTO.DatabaseAvailable = false;
                    _cartsApiResourceDTO.Message = $"Database error. Please try again.";
                }
            }
        }
        else
        {
            _cartsApiResourceDTO.ServiceAvailable = false;
            _cartsApiResourceDTO.Message = $"Carts API unavailable. Please try again.";
            _cartsApiResourceDTO.DatabaseAvailable = false;
        }
        _cartsApiResourceDTO.Progress = "Complete";
        _cartsThinking = false;
    }

    private async Task PingOrdersAPI()
    {
        _ordersThinking = true;
        _ordersApiResourceDTO.Reset();
        _ordersApiResourceDTO.Progress = "...checking Orders API...";
        var result = await AzureServicesClient.CheckOrdersApiAsync();
        if (result.IsSuccess)
        {
            _ordersApiResourceDTO.ServiceAvailable = true;
            _ordersApiResourceDTO.Message = "API success";   // result.Result;
            if (_checkMongoDatabases)
            {
                // check Mongo Database
                _ordersApiResourceDTO.Progress = "...checking Orders Database...";
                var mongoResult = await AzureServicesClient.CheckOrdersMongoAsync();
                if (mongoResult.IsSuccess)
                {
                    _ordersApiResourceDTO.DatabaseAvailable = true;
                    _ordersApiResourceDTO.Message = $"{result.Result}";
                }
                else
                {
                    _ordersApiResourceDTO.DatabaseAvailable = false;
                    _ordersApiResourceDTO.Message = $"Database error. Please try again.";
                }
            }
        }
        else
        {
            _ordersApiResourceDTO.ServiceAvailable = false;
            _ordersApiResourceDTO.Message = $"Orders API unavailable. Please try again.";
            _ordersApiResourceDTO.DatabaseAvailable = false;
        }
        _ordersApiResourceDTO.Progress = "Complete";
        _ordersThinking = false;
    }

    private async Task PingProductsReadAPI()
    {
        _productsReadThinking = true;
        _productsReadApiResourceDTO.Reset();
        _productsReadApiResourceDTO.Progress = "...checking API...";
        var result = await AzureServicesClient.CheckProductsReadApiAsync();
        if (result.IsSuccess)
        {
            _productsReadApiResourceDTO.ServiceAvailable = true;
            _productsReadApiResourceDTO.Message = "API success";   // result.Result;
            if (_checkSqlDatabases)
            {
                // check Sql Database
                _productsReadApiResourceDTO.Progress = "...checking Database...";
                StateHasChanged();
                var databaseResult = await AzureServicesClient.CheckProductsReadSqlAsync(_cancellationTokenSource!.Token);
                if (databaseResult.IsSuccess)
                {
                    _productsReadApiResourceDTO.DatabaseAvailable = true;
                    _productsReadApiResourceDTO.Message = $"{result.Result}";
                }
                else
                {
                    _productsReadApiResourceDTO.DatabaseAvailable = false;
                    _productsReadApiResourceDTO.Message = $"Database error. Please try again.";
                }
            }
        }
        else
        {
            _productsReadApiResourceDTO.ServiceAvailable = false;
            _productsReadApiResourceDTO.Message = $"API error. Please try again.";
            _productsReadApiResourceDTO.DatabaseAvailable = false;
        }

        _productsReadApiResourceDTO.Progress = "Complete";
        _productsReadThinking = false;
    }

    private async Task PingProductsWriteAPI()
    {
        _productsWriteThinking = true;
        _productsWriteApiResourceDTO.Reset();
        _productsWriteApiResourceDTO.Progress = "...checking API...";
        var result = await AzureServicesClient.CheckProductsWriteApiAsync();
        if (result.IsSuccess)
        {
            _productsWriteApiResourceDTO.ServiceAvailable = true;
            _productsWriteApiResourceDTO.Message = "API success";   // result.Result;
            if (_checkSqlDatabases)
            {
                // check Sql Database
                _productsWriteApiResourceDTO.Progress = "...checking Database...";
                StateHasChanged();
                var databaseResult = await AzureServicesClient.CheckProductsWriteSqlAsync(_cancellationTokenSource!.Token);
                if (databaseResult.IsSuccess)
                {
                    _productsWriteApiResourceDTO.DatabaseAvailable = true;
                    _productsWriteApiResourceDTO.Message = $"{result.Result}";
                }
                else
                {
                    _productsWriteApiResourceDTO.DatabaseAvailable = false;
                    _productsWriteApiResourceDTO.Message = $"Database error. Please try again.";
                }
            }
        }
        else
        {
            _productsWriteApiResourceDTO.ServiceAvailable = false;
            _productsWriteApiResourceDTO.Message = $"API error. Please try again.";
            _productsWriteApiResourceDTO.DatabaseAvailable = false;
        }

        _productsWriteApiResourceDTO.Progress = "Complete";
        _productsWriteThinking = false;
    }

    // private async Task PingYarpProxy()
    // {
    //     _thinking = true;
    //     _yarpResourceDTO.Reset();
    //     _yarpResourceDTO.Progress = "...pinging YARP Proxy...";
    //     _yarpResourceDTO.DatabaseAvailable = true;
    //     var result = await AzureServicesClient.CheckYarpProxyAsync();
    //     if (result.IsSuccess)
    //     {
    //         _yarpResourceDTO.ServiceAvailable = true;
    //         _yarpResourceDTO.Message = result.Result;
    //     }
    //     else
    //     {
    //         _yarpResourceDTO.ServiceAvailable = false;
    //         _yarpResourceDTO.Message = $"YARP Proxy unavailable. Please try again.";
    //         _yarpResourceDTO.DatabaseAvailable = false;
    //     }
    //     _yarpResourceDTO.Progress = "Complete";
    //     _thinking = false;
    // }

    private async Task PingYarpProxy()
    {
        _yarpThinking = true;
        _yarpProxyResponse = "...pinging YARP Proxy...";
        var result = await AzureServicesClient.CheckYarpProxyAsync();
        if (result.IsSuccess) _yarpProxyResponse = result.Result;
        else _yarpProxyResponse = result.ErrorMessage;
        _yarpThinking = false;
    }
    private void ClearYarpProxyResponse() => _yarpProxyResponse = null;

    private async Task PingAllPawnshopEndpoints()
    {
        var tasks = new List<Task>
        {
            PingAccountsAPI(),
            PingCartsAPI(),
            PingOrdersAPI(),
            PingProductsReadAPI(),
            PingProductsWriteAPI(),
            PingYarpProxy()
        };
        await Task.WhenAll(tasks);
    }

    protected override void OnInitialized()
    {
        _resourceDTOs = new List<ResourceStatusDTO>()
        {
            _accountsApiResourceDTO, _cartsApiResourceDTO, _ordersApiResourceDTO, 
            _productsReadApiResourceDTO, _productsWriteApiResourceDTO, // _yarpResourceDTO
        };
        base.OnInitialized();
    }

    public void Dispose()
    {
        _cancellationTokenSource?.Cancel();
        _cancellationTokenSource?.Dispose();
        _cancellationTokenSource = null;
    }
}
