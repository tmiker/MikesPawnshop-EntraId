    private async Task PingAccountsAPI()
    {
        _thinking = true;
        _accountsApiResourceDTO.Reset();
        _accountsApiResourceDTO.Progress = "...checking Accounts API...";
        var result = await AzureServicesClient.CheckAccountsApiAsync();
        if (result.IsSuccess)
        {
            _accountsApiResourceDTO.ServiceAvailable = true;
            _accountsApiResourceDTO.Message = "API success.";   // result.Result;
            // check Mongo Database
            _accountsApiResourceDTO.Progress = "...checking Accounts Database...";
            var mongoResult = await AzureServicesClient.CheckAccountsMongoAsync();
            if (mongoResult.IsSuccess)
            {
                _accountsApiResourceDTO.DatabaseAvailable = true;
                _accountsApiResourceDTO.Message = $"Success. {result.Result}";
            }
            else
            {
                _accountsApiResourceDTO.DatabaseAvailable = false;
                _accountsApiResourceDTO.Message = $"Database error. Please try again.";
            }
        }
        else 
        {
            _accountsApiResourceDTO.ServiceAvailable = false;
            _accountsApiResourceDTO.Message = $"Accounts API unavailable. Please try again.";
            _accountsApiResourceDTO.DatabaseAvailable = false;
        }
        _accountsApiResourceDTO.Progress = "Complete";
        _thinking = false;
    }
    // private void ClearAccountsApiResponse() => _accountsApiResponse = null;

