@using Microsoft.AspNetCore.Components.Authorization

<nav class="navbar navbar-expand-md navbar-dark">
    <div class="container-fluid">
        @* <a class="navbar-brand" href="">Blazor Template</a> *@
        <a class="px-3" href="">
            <img src="logos/logo10.png" height="44" alt="logo" />
        </a>
        <h6 class="text-warning-alt mt-3 mx-5 my-3"><i><b>ADMIN</b></i></h6>
        <button class="navbar-toggler @NavButtonCssClass" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse"
                aria-controls="navbarCollapse" aria-label="Toggle navigation" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse @NavBarCssClass" id="navbarCollapse" @onclick="ToggleNavMenu">
            <ul class="navbar-nav me-auto mb-2 mb-md-0">
                <li class="nav-item px-3">
                </li>
                <li class="nav-item px-3">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <i class="bi-house-door"></i> Home
                        <span class="visually-hidden">(current)</span>
                    </NavLink>
                </li>

                <AuthorizeView Policy="IsAdminOrManager">
                    <Authorized>
                        <li class="nav-item px-3 dropdown">
                            <NavLink class="nav-link dropdown-toggle" href="dev" data-bs-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
                                <i class="bi-code-slash"></i> &nbsp; Developers
                            </NavLink>
                            <div class="dropdown-menu dropdown-menu-dark">
                                <NavLink class="dropdown-item" href="dev/testProductsWriteApi" Match="NavLinkMatch.All">
                                    <i class="bi-lightning"></i> &nbsp; Test Products Write API Exceptions
                                </NavLink>
                                @* <NavLink class="dropdown-item" href="dev/testProductsReadApi" Match="NavLinkMatch.All">
                                    <i class="bi-lightning"></i> &nbsp; Products Read API Testing
                                </NavLink> *@
                                <div class="dropdown-divider"></div>
                                <NavLink class="dropdown-item" href="dev/toastr-demo-server" Match="NavLinkMatch.All">
                                    <i class="bi-lightning"></i> &nbsp; Test Server-Side Toasts
                                </NavLink>
                                <div class="dropdown-divider"></div>
                                <NavLink class="dropdown-item" href="dev/toastr-demo-client" Match="NavLinkMatch.All">
                                    <i class="bi-lightning"></i> &nbsp; Test Client-Side Toasts
                                </NavLink>
                                @* <div class="dropdown-divider"></div> *@
                                @* <NavLink class="dropdown-item" href="dev/accounts-api-testing" Match="NavLinkMatch.All">
                                    <i class="bi-lightning"></i> &nbsp; Test Accounts API
                                </NavLink> *@
                                <div class="dropdown-divider"></div>
                                <NavLink class="dropdown-item" href="dev/testAccessDeniedRouting" Match="NavLinkMatch.All">
                                    <i class="bi-emoji-astonished-fill"></i> &nbsp; Test Access Denied Routing
                                </NavLink>
                            </div>
                        </li>
                        <li class="nav-item px-3 dropdown">
                            <NavLink class="nav-link dropdown-toggle" href="claims" data-bs-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
                                <i class="bi-person-fill"></i> &nbsp; User Claims
                            </NavLink>
                            <div class="dropdown-menu dropdown-menu-dark">
                                <NavLink class="dropdown-item" href="claims/accountsApiClaims" Match="NavLinkMatch.All">
                                    <i class="bi-person-fill"></i> &nbsp; Accounts API Claims
                                </NavLink>
                                <NavLink class="dropdown-item" href="claims/cartsApiClaims" Match="NavLinkMatch.All">
                                    <i class="bi-person-fill"></i> &nbsp; Carts API Claims
                                </NavLink>
                                <NavLink class="dropdown-item" href="claims/ordersApiClaims" Match="NavLinkMatch.All">
                                    <i class="bi-person-fill"></i> &nbsp; Orders API Claims
                                </NavLink>
                                <NavLink class="dropdown-item" href="claims/productsReadApiClaims" Match="NavLinkMatch.All">
                                    <i class="bi-person-fill"></i> &nbsp; Products Read API Claims
                                </NavLink>
                                <NavLink class="dropdown-item" href="claims/productsWriteApiClaims" Match="NavLinkMatch.All">
                                    <i class="bi-person-fill"></i> &nbsp; Products Write API Claims
                                </NavLink>
                                <div class="dropdown-divider"></div>
                                <NavLink class="dropdown-item" href="claims/blazorServerClaims" Match="NavLinkMatch.All">
                                    <i class="bi-person-fill"></i> &nbsp; Blazor Server Claims
                                </NavLink>
                                
                            </div>
                        </li>

                        <li class="nav-item px-3 dropdown">
                            <NavLink class="nav-link dropdown-toggle" href="products" data-bs-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
                                <i class="bi-box-seam"></i> &nbsp; Product Management
                            </NavLink>
                            <div class="dropdown-menu dropdown-menu-dark">
                                <NavLink class="dropdown-item" href="products/productsList" Match="NavLinkMatch.All">
                                    <i class="bi bi-list-nested-nav-menu"></i> &nbsp; Manage Products
                                </NavLink>
                                <div class="dropdown-divider"></div>
                                <NavLink class="dropdown-item" href="products/productSnapshotsWrite" Match="NavLinkMatch.All">
                                    <i class="bi bi-list-nested-nav-menu"></i> &nbsp; Write Side Products (from events)
                                </NavLink>
                                <NavLink class="dropdown-item" href="products/eventRecordsWrite" Match="NavLinkMatch.All">
                                    <i class="bi bi-list-nested-nav-menu"></i> &nbsp; Write Side Event Records
                                </NavLink>
                                <NavLink class="dropdown-item" href="products/outboxRecordsWrite" Match="NavLinkMatch.All">
                                    <i class="bi bi-list-nested-nav-menu"></i> &nbsp; Write Side Outbox Records
                                </NavLink>
                                <NavLink class="dropdown-item" href="products/snapshotRecordsWrite" Match="NavLinkMatch.All">
                                    <i class="bi bi-list-nested-nav-menu"></i> &nbsp; Write Side Snapshot Records
                                </NavLink>
                                <div class="dropdown-divider"></div>
                                <NavLink class="dropdown-item" href="products/productsRead" Match="NavLinkMatch.All">
                                    <i class="bi bi-list-nested-nav-menu"></i> &nbsp; Read Side Products  (public client)
                                </NavLink>
                            </div>
                        </li>

                        <li class="nav-item px-3 dropdown">
                            <NavLink class="nav-link dropdown-toggle" href="store" data-bs-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
                                <i class="bi-shop"></i> &nbsp; Store
                            </NavLink>
                            <div class="dropdown-menu dropdown-menu-dark">
                                <NavLink class="dropdown-item" href="store/storefront" Match="NavLinkMatch.All">
                                    <i class="bi bi-list-nested-nav-menu"></i> &nbsp; Storefront
                                </NavLink>
                                <NavLink class="dropdown-item" href="store/myOrders" Match="NavLinkMatch.All">
                                    <i class="bi bi-list-nested-nav-menu"></i> &nbsp; My Orders
                                </NavLink>
                                <NavLink class="dropdown-item" href="store/myAccount" Match="NavLinkMatch.All">
                                    <i class="bi bi-list-nested-nav-menu"></i> &nbsp; My Account
                                </NavLink>
                            </div>
                        </li>

                        @* <li class="nav-item px-3 dropdown">
                            <NavLink class="nav-link dropdown-toggle" href="orders" data-bs-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
                                <i class="bi-mailbox-flag"></i> &nbsp; Orders
                            </NavLink>
                            <div class="dropdown-menu dropdown-menu-dark">
                                <NavLink class="dropdown-item" href="orders/myOrders" Match="NavLinkMatch.All">
                                    <i class="bi bi-list-nested-nav-menu"></i> &nbsp; My Orders
                                </NavLink>
                            </div>
                        </li>

                        <li class="nav-item px-3 dropdown">
                            <NavLink class="nav-link dropdown-toggle" href="account" data-bs-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
                                <i class="bi-currency-dollar"></i> &nbsp; Account
                            </NavLink>
                            <div class="dropdown-menu dropdown-menu-dark">
                                <NavLink class="dropdown-item" href="account/myAccount" Match="NavLinkMatch.All">
                                    <i class="bi bi-list-nested-nav-menu"></i> &nbsp; My Account
                                </NavLink>
                            </div>
                        </li> *@
                    </Authorized>
                </AuthorizeView>
            </ul>
            <div>
                <div class="d-flex">
                    <LoginDisplay />
                </div>
            </div>
        </div>
    </div>
</nav>
<BannerTop />

@code {
    private bool collapseNavMenu = true;
    private string? NavBarCssClass => collapseNavMenu ? null : "show";
    private string? NavButtonCssClass => collapseNavMenu ? "collapsed" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}

