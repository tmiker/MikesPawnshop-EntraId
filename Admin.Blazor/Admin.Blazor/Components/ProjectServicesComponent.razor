@page "/ping-services"
@inject IAzureServicesHttpClient AzureServicesClient
@rendermode InteractiveServer

<PageTitle>Pawnshop Services</PageTitle>

<h6 class="mt-2">Check Pawnshop API Resource and Reverse Proxy Status</h6>

<div class="row mt-4">
    <div class="col-3">
        <a class="btn button-custom-primary-med form-control" @onclick="PingAccountsAPI">Ping Accounts API</a>
    </div>
    <div class="col-7">
        <input type="text" class="bg-dark text-light form-control" @bind-value="_accountsApiResponse" />
    </div>
    @if (!string.IsNullOrEmpty(_accountsApiResponse))
    {
        <div class="col-2">
            <a class="btn button-custom-secondary-med form-control" @onclick="ClearAccountsApiResponse">Clear</a>
        </div>
    }
</div>

<div class="row mt-4">
    <div class="col-3">
        <a class="btn button-custom-primary-med form-control" @onclick="PingCartsAPI">Ping Carts API</a>
    </div>
    <div class="col-7">
        <input type="text" class="bg-dark text-light form-control" @bind-value="_cartsApiResponse" />
    </div>
    @if (!string.IsNullOrEmpty(_cartsApiResponse))
    {
        <div class="col-2">
            <a class="btn button-custom-secondary-med form-control" @onclick="ClearCartsApiResponse">Clear</a>
        </div>
    }
</div>

<div class="row mt-4">
    <div class="col-3">
        <a class="btn button-custom-primary-med form-control" @onclick="PingOrdersAPI">Ping Orders API</a>
    </div>
    <div class="col-7">
        <input type="text" class="bg-dark text-light form-control" @bind-value="_ordersApiResponse" />
    </div>
    @if (!string.IsNullOrEmpty(_ordersApiResponse))
    {
        <div class="col-2">
            <a class="btn button-custom-secondary-med form-control" @onclick="ClearOrdersApiResponse">Clear</a>
        </div>
    }
</div>

<div class="row mt-4">
    <div class="col-3">
        <a class="btn button-custom-primary-med form-control" @onclick="PingProductsReadAPI">Ping Products Read API</a>
    </div>
    <div class="col-7">
        <textarea class="bg-dark text-light form-control" rows="2">@_productsReadApiResponse</textarea>
    </div>
    @if (!string.IsNullOrEmpty(_productsReadApiResponse))
    {
        <div class="col-2">
            <a class="btn button-custom-secondary-med form-control" @onclick="ClearProductsReadApiResponse">Clear</a>
        </div>
    }
</div>

<div class="row mt-4">
    <div class="col-3">
        <a class="btn button-custom-primary-med form-control" @onclick="PingProductsWriteAPI">Ping Products Write API</a>
    </div>
    <div class="col-7">
        <textarea class="bg-dark text-light form-control" rows="2">@_productsWriteApiResponse</textarea>
    </div>

    @if (!string.IsNullOrEmpty(_productsWriteApiResponse))
    {
        <div class="col-2">
            <a class="btn button-custom-secondary-med form-control" @onclick="ClearProductsWriteApiResponse">Clear</a>
        </div>
    }
</div>

<div class="row mt-4">
    <div class="col-3">
        <a class="btn button-custom-primary-med form-control" @onclick="PingYarpProxy">Ping YARP Proxy</a>
    </div>
    <div class="col-7">
        <input type="text" class="bg-dark text-light form-control" @bind-value="_yarpProxyResponse" />
    </div>
    @if (!string.IsNullOrEmpty(_yarpProxyResponse))
    {
        <div class="col-2">
            <a class="btn button-custom-secondary-med form-control" @onclick="ClearYarpProxyResponse">Clear</a>
        </div>
    }
</div>

<div class="row mt-4">
    <div class="col-3">
        <a class="btn button-custom-success-med form-control" @onclick="PingAllPawnshopEndpoints">Ping All Endpoints</a>
    </div>
    <div class="col-7">
        <input type="text" class="bg-dark text-light form-control" @bind-value="_pingAllResult" />
    </div>
    @if (!string.IsNullOrEmpty(_pingAllResult))
    {
        <div class="col-2">
            <a class="btn button-custom-secondary-med form-control" @onclick="ClearPingAllPawnshopEndpointsResult">Clear</a>
        </div>
    }
</div>

@if (_thinking || _allThinking)
{
    <div class="mx-auto text-center mb-3 mt-3">
        <div class="spinner-border text-success role-status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}

@code {
    private bool _thinking = false;
    private bool _allThinking = false;
    private string? _accountsApiResponse;
    private string? _cartsApiResponse;
    private string? _ordersApiResponse;
    private string? _productsReadApiResponse;
    private string? _productsWriteApiResponse;
    private string? _productsReadSqlResponse;
    private string? _productsWriteSqlResponse;
    private string? _yarpProxyResponse;
    private string? _pingAllResult;
    private bool _productsReadApiSuccess = false;
    private bool _productsWriteApiSuccess = false;

    private async Task PingAccountsAPI()
    {
        _thinking = true;
        _accountsApiResponse = "...pinging Accounts API...";
        var result = await AzureServicesClient.CheckAccountsApiAsync();
        if (result.IsSuccess) _accountsApiResponse = result.Result;
        else _accountsApiResponse = result.ErrorMessage;
        _thinking = false;
    }
    private void ClearAccountsApiResponse() => _accountsApiResponse = null;

    private async Task PingCartsAPI()
    {
        _thinking = true;
        _cartsApiResponse = "...pinging Carts API...";
        var result = await AzureServicesClient.CheckCartsApiAsync();
        if (result.IsSuccess) _cartsApiResponse = result.Result;
        else _cartsApiResponse = result.ErrorMessage;
        _thinking = false;
    }
    private void ClearCartsApiResponse() => _cartsApiResponse = null;

    private async Task PingOrdersAPI()
    {
        _thinking = true;
        _ordersApiResponse = "...pinging Orders API...";
        var result = await AzureServicesClient.CheckOrdersApiAsync();
        if (result.IsSuccess) _ordersApiResponse = result.Result;
        else _ordersApiResponse = result.ErrorMessage;
        _thinking = false;
    }
    private void ClearOrdersApiResponse() => _ordersApiResponse = null;

    private async Task PingProductsReadAPI()
    {
        _thinking = true;
        _productsReadApiResponse = "...pinging Products Read API...";

        var result = await AzureServicesClient.CheckProductsReadApiAsync();
        if (result.IsSuccess) 
        {
            _productsReadApiResponse = $"{result.Result} \nChecking database...";
            _productsReadApiSuccess = true;
        }
        else _productsReadApiResponse = result.ErrorMessage;

        if (_productsReadApiSuccess)
        {
            var databaseResult = await AzureServicesClient.CheckProductsReadSqlAsync();
            if (databaseResult.IsSuccess) _productsReadApiResponse = $"{result.Result} \n{databaseResult.Result}";
            else _productsReadApiResponse = $"{result.Result} \n{databaseResult.ErrorMessage}";
        }

        _thinking = false;
    }
    private void ClearProductsReadApiResponse() { _productsReadApiResponse = null; _productsReadApiSuccess = false; }

    private async Task PingProductsWriteAPI()
    {
        _thinking = true;
        _productsWriteApiResponse = "...pinging Products Write API...";

        var result = await AzureServicesClient.CheckProductsWriteApiAsync();
        if (result.IsSuccess) 
        {
            _productsWriteApiResponse = $"{result.Result} \nChecking database...";
            _productsWriteApiSuccess = true;
        }
        else _productsWriteApiResponse = result.ErrorMessage;

        if (_productsWriteApiSuccess)
        {
            var databaseResult = await AzureServicesClient.CheckProductsWriteSqlAsync();
            if (databaseResult.IsSuccess) _productsWriteApiResponse = $"{result.Result} \n{databaseResult.Result}";
            else _productsWriteApiResponse = $"{result.Result} \n{databaseResult.ErrorMessage}";
        }

        _thinking = false;
    }
    private void ClearProductsWriteApiResponse() { _productsWriteApiResponse = null; _productsWriteApiSuccess = false; }

    private async Task PingProductsReadSql()
    {
        _thinking = true;
        _productsReadSqlResponse = "...pinging Products Read SQL database...";
        var result = await AzureServicesClient.CheckProductsReadSqlAsync();
        if (result.IsSuccess) _productsReadSqlResponse = result.Result;
        else _productsReadSqlResponse = result.ErrorMessage;
        _thinking = false;
    }
    private void ClearProductsReadSqlResponse() => _productsReadSqlResponse = null;

    private async Task PingProductsWriteSql()
    {
        _thinking = true;
        _productsWriteSqlResponse = "...pinging Products Write SQL database...";
        var result = await AzureServicesClient.CheckProductsWriteSqlAsync();
        if (result.IsSuccess) _productsWriteSqlResponse = result.Result;
        else _productsWriteSqlResponse = result.ErrorMessage;
        _thinking = false;
    }
    private void ClearProductsWriteSqlResponse() => _productsWriteSqlResponse = null;

    private async Task PingYarpProxy()
    {
        _thinking = true;
        _yarpProxyResponse = "...pinging YARP Proxy...";
        var result = await AzureServicesClient.CheckYarpProxyAsync();
        if (result.IsSuccess) _yarpProxyResponse = result.Result;
        else _yarpProxyResponse = result.ErrorMessage;
        _thinking = false;
    }
    private void ClearYarpProxyResponse() => _yarpProxyResponse = null;

    private async Task PingAllPawnshopEndpoints()
    {
        _allThinking = true;
        var tasks = new List<Task>
        {
            PingAccountsAPI(),
            PingCartsAPI(),
            PingOrdersAPI(),
            PingProductsReadAPI(),
            PingProductsWriteAPI(),
            PingYarpProxy()
        };
        await Task.WhenAll(tasks);

        _pingAllResult = "Finished pinging all resources.";
        _allThinking = false;
    }
    private void ClearPingAllPawnshopEndpointsResult()
    {
        _pingAllResult = null;
        _accountsApiResponse = null;
        _cartsApiResponse = null;
        _ordersApiResponse = null;
        _productsReadApiResponse = null;
        _productsWriteApiResponse = null;
        _productsReadSqlResponse = null;
        _productsWriteSqlResponse = null;
        _yarpProxyResponse = null;
        _pingAllResult = null;
        _productsReadApiSuccess = false;
        _productsWriteApiSuccess = false;
        _thinking = false;
        _allThinking = false;
    }

    
}
