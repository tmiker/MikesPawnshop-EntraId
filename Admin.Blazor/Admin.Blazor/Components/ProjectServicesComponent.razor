@if (_thinking)
{
    <div class="mx-auto text-center mb-3 mt-3">
        <div class="spinner-border text-success role-status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}

@code {
    [Inject]
    public IConfiguration Configuration { get; set; } = default!;
    [Inject]
    public static HttpClient Client { get; set; } = new HttpClient();
    // [Inject]
    // public IWebHostEnvironment WebHostEnv { get; set; } = default!;

    private bool _thinking = false;
    private string? _accountsApiResponse;
    private string? _cartsApiResponse;
    private string? _ordersApiResponse;
    private string? _productsReadApiResponse;
    private string? _productsWriteApiResponse;
    private string? _productsReadSqlResponse;
    private string? _productsWriteSqlResponse;
    private string? _yarpProxyResponse;
    private string? _pingAllResult;

    private async Task PingAccountsAPI()
    {
        _thinking = true;
        var baseUrl = Configuration["AccountsApiBaseURL"];
        try
        {
            _accountsApiResponse = "...pinging Accounts API...";
            using (var response = await Client.GetAsync($"{baseUrl}"))
            {
                if (response.IsSuccessStatusCode)
                {
                    _accountsApiResponse = await response.Content.ReadAsStringAsync();
                }
                else
                {
                    _accountsApiResponse = "Failed to reach Accounts API.";
                }
                _thinking = false;
            }
        }
        catch (Exception ex)
        {
            _accountsApiResponse = $"Accounts API Error: {ex.Message}";
            _thinking = false;
        }
    }
    private void ClearAccountsApiResponse() => _accountsApiResponse = null;

    private async Task PingCartsAPI()
    {
        _thinking = true;
        var baseUrl = Configuration["CartsApiBaseURL"];
        try
        {
            _cartsApiResponse = "...pinging Carts API...";
            using (var response = await Client.GetAsync($"{baseUrl}"))
            {
                if (response.IsSuccessStatusCode)
                {
                    _cartsApiResponse = await response.Content.ReadAsStringAsync();
                }
                else
                {
                    _cartsApiResponse = "Failed to reach Carts API.";
                }
                _thinking = false;
            }
        }
        catch (Exception ex)
        {
            _cartsApiResponse = $"Carts API Error: {ex.Message}";
            _thinking = false;
        }
    }
    private void ClearCartsApiResponse() => _cartsApiResponse = null;

    private async Task PingOrdersAPI()
    {
        _thinking = true;
        var baseUrl = Configuration["OrdersApiBaseURL"];
        try
        {
            _ordersApiResponse = "...pinging Orders API...";
            using (var response = await Client.GetAsync($"{baseUrl}"))
            {
                if (response.IsSuccessStatusCode)
                {
                    _ordersApiResponse = await response.Content.ReadAsStringAsync();
                }
                else
                {
                    _ordersApiResponse = "Failed to reach Orders API.";
                }
                _thinking = false;
            }
        }
        catch (Exception ex)
        {
            _ordersApiResponse = $"Orders API Error: {ex.Message}";
            _thinking = false;
        }
    }
    private void ClearOrdersApiResponse() => _ordersApiResponse = null;

    private async Task PingProductsReadAPI()
    {
        _thinking = true;
        var baseUrl = Configuration["ProductsReadApiBaseURL"];
        try
        {
            _productsReadApiResponse = "...pinging Products Read API...";
            using (var response = await Client.GetAsync($"{baseUrl}"))
            {
                if (response.IsSuccessStatusCode)
                {
                    _productsReadApiResponse = await response.Content.ReadAsStringAsync();
                    await PingProductsReadSql();
                }
                else
                {
                    _productsReadApiResponse = "Failed to reach Products Read API.";
                }
                _thinking = false;
            }
        }
        catch (Exception ex)
        {
            _productsReadApiResponse = $"Products Read API Error: {ex.Message}";
            _thinking = false;
        }
    }
    private void ClearProductsReadApiResponse() => _productsReadApiResponse = null;

    private async Task PingProductsWriteAPI()
    {
        _thinking = true;
        var baseUrl = Configuration["ProductsWriteApiBaseURL"];
        try
        {
            _productsWriteApiResponse = "...pinging Products Write API...";
            using (var response = await Client.GetAsync($"{baseUrl}"))
            {
                if (response.IsSuccessStatusCode)
                {
                    _productsWriteApiResponse = await response.Content.ReadAsStringAsync();
                    await PingProductsWriteSql();
                }
                else
                {
                    _productsWriteApiResponse = "Failed to reach Products Write API.";
                }
                _thinking = false;
            }
        }
        catch (Exception ex)
        {
            _productsWriteApiResponse = $"Products Write API Error: {ex.Message}";
            _thinking = false;
        }
    }
    private void ClearProductsWriteApiResponse() => _productsWriteApiResponse = null;

    private async Task PingProductsReadSql()
    {
        _thinking = true;
        var baseUrl = Configuration["ProductsReadApiBaseURL"];
        var sqlPingUrl = $"{baseUrl}/api/products/productCount";
        try
        {
            _productsReadSqlResponse = $"Pinging {sqlPingUrl}"; // "...pinging Products Read SQL database...";
            using (var response = await Client.GetAsync($"{sqlPingUrl}"))
            {
                if (response.IsSuccessStatusCode)
                {
                    string countResult = await response.Content.ReadAsStringAsync();
                    _productsReadSqlResponse = $"Product Read Side database is running. Product Count: {countResult}";
                }
                else
                {
                    _productsReadSqlResponse = "Failed to reach Products Read SQL database.";
                }
                _thinking = false;
            }
        }
        catch (Exception ex)
        {
            _productsReadSqlResponse = $"Products Read SQL Error: {ex.Message}";
            _thinking = false;
        }
    }
    private void ClearProductsReadSqlResponse() => _productsReadSqlResponse = null;

    private async Task PingProductsWriteSql()
    {
        _thinking = true;
        var baseUrl = Configuration["ProductsWriteApiBaseURL"];
        var sqlPingUrl = $"{baseUrl}/dev/productsManagment/eventCount";
        try
        {
            _productsWriteSqlResponse = "...pinging Products Write SQL database...";
            using (var response = await Client.GetAsync($"{sqlPingUrl}"))
            {
                if (response.IsSuccessStatusCode)
                {
                    string countResult = await response.Content.ReadAsStringAsync();
                    _productsWriteSqlResponse = $"Product Write Side database is running. Event Count: {countResult}";
                }
                else
                {
                    _productsWriteSqlResponse = "Failed to reach Products Write SQL database.";
                }
                _thinking = false;
            }
        }
        catch (Exception ex)
        {
            _productsWriteSqlResponse = $"Products Write SQL Error: {ex.Message}";
            _thinking = false;
        }
    }
    private void ClearProductsWriteSqlResponse() => _productsWriteSqlResponse = null;

    private async Task PingYarpProxy()
    {
        _thinking = true;
        var baseUrl = Configuration["YarpProxyBaseURL"];
        try
        {
            _yarpProxyResponse = "...pinging YARP Proxy...";
            using (var response = await Client.GetAsync($"{baseUrl}"))
            {
                if (response.IsSuccessStatusCode)
                {
                    _yarpProxyResponse = await response.Content.ReadAsStringAsync();
                }
                else
                {
                    _yarpProxyResponse = "Failed to reach YARP Proxy.";
                }
                _thinking = false;
            }
        }
        catch (Exception ex)
        {
            _yarpProxyResponse = $"YARP Proxy Error: {ex.Message}";
            _thinking = false;
        }
    }
    private void ClearYarpProxyResponse() => _yarpProxyResponse = null;

    private async Task PingAllPawnshopEndpoints()
    {
        _thinking = true;
        var tasks = new List<Task>
        {
            PingAccountsAPI(),
            PingCartsAPI(),
            PingOrdersAPI(),
            PingProductsReadAPI(),
            PingProductsWriteAPI(),
            PingYarpProxy()
            // PingConsumerClient()
        };
        await Task.WhenAll(tasks);
        _pingAllResult = "Finished pinging all endpoints.";
        _thinking = false;
    }
    private void ClearPingAllPawnshopEndpointsResult()
    {
        _pingAllResult = null;
        _accountsApiResponse = null;
        _cartsApiResponse = null;
        _ordersApiResponse = null;
        _productsReadApiResponse = null;
        _productsWriteApiResponse = null;
        _productsReadSqlResponse = null;
        _productsWriteSqlResponse = null;
        _yarpProxyResponse = null;
        _pingAllResult = null;
    }

    
}
