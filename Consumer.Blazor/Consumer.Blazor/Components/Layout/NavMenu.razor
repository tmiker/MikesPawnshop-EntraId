
<nav class="navbar navbar-expand-md navbar-dark">
    <div class="container-fluid">
        <a class="px-3" href="">
            <img src="logos/logo10.png" height="44" alt="logo" />
        </a>

        <button class="navbar-toggler @NavButtonCssClass" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse"
                aria-controls="navbarCollapse" aria-label="Toggle navigation" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse @NavBarCssClass" id="navbarCollapse" @onclick="ToggleNavMenu">
            <ul class="navbar-nav me-auto mb-2 mb-md-0">
                <li class="nav-item px-3">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <i class="bi-house-door"></i> Home
                        <span class="visually-hidden">(current)</span>
                    </NavLink>
                </li>
                <li class="nav-item px-3">
                    <NavLink class="nav-link" href="store/storefront" Match="NavLinkMatch.All">
                        <i class="bi-shop"></i> &nbsp; Storefront
                    </NavLink>
                </li>

                <AuthorizeView>
                    <Authorized>
                        <li class="nav-item px-3">
                            <NavLink class="nav-link" href="orders/myOrders" Match="NavLinkMatch.All">
                                <i class="bi-mailbox-flag"></i> &nbsp; My Orders
                            </NavLink>
                        </li>
                        <li class="nav-item px-3">
                            <NavLink class="nav-link" href="account/myAccount" Match="NavLinkMatch.All">
                                <i class="bi-currency-dollar"></i> &nbsp; My Account
                            </NavLink>
                        </li>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Policy="IsAdminOrManager">
                    <Authorized>
                        <li class="nav-item px-3 dropdown">
                            <NavLink class="nav-link dropdown-toggle" href="claims" data-bs-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
                                <i class="bi-person-fill"></i> &nbsp; User Claims
                            </NavLink>
                            <div class="dropdown-menu dropdown-menu-dark">
                                <NavLink class="dropdown-item" href="claims/apiResourceClaims" Match="NavLinkMatch.All">
                                    <i class="bi-person-fill"></i> &nbsp; API Resource Claims
                                </NavLink>
                                <div class="dropdown-divider"></div>
                                <NavLink class="dropdown-item" href="claims/blazorServerClaims" Match="NavLinkMatch.All">
                                    <i class="bi-person-fill"></i> &nbsp; Blazor Server Claims
                                </NavLink>

                            </div>
                        </li>
                        <li class="nav-item px-3 dropdown">
                            <NavLink class="nav-link dropdown-toggle" href="dev" data-bs-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
                                <i class="bi-code-slash"></i> &nbsp; Development
                            </NavLink>
                            <div class="dropdown-menu dropdown-menu-dark">
                                <NavLink class="dropdown-item" href="dev/testProductsReadApi" Match="NavLinkMatch.All">
                                    <i class="bi-lightning"></i> &nbsp; Products Read API Testing
                                </NavLink>
                                <div class="dropdown-divider"></div>
                                <NavLink class="dropdown-item" href="dev/testAccessDeniedRouting" Match="NavLinkMatch.All">
                                    <i class="bi-emoji-astonished-fill"></i> &nbsp; Test Access Denied Routing
                                </NavLink>
                            </div>
                        </li>
                    </Authorized>
                </AuthorizeView>
            </ul>
            <div>
                <div class="d-flex">
                    <LoginDisplay />
                </div>
            </div>
        </div>
    </div>
</nav>
<BannerTop />

@code {
    private bool collapseNavMenu = true;
    private string? NavBarCssClass => collapseNavMenu ? null : "show";
    private string? NavButtonCssClass => collapseNavMenu ? "collapsed" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}