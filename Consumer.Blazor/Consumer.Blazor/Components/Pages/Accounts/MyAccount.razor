@page "/account/myAccount"
@rendermode InteractiveServer
@inject IAccountsHttpService _accountHttpService
@attribute [Authorize]

<div class="row mt-2">

    <div class="col-8">
        <h4><b>My Account</b></h4>
    </div>
    @if (_thinking)
    {
        <div class="mx-auto text-center mb-3 mt-3">
            <div class="spinner-border text-yellow-alt role-status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        @if (_accountInfo is null)
        {
            <div class="col-2">
                <a class="btn button-custom-success-med form-control" @onclick="AddAccount">Add Account Info</a>
            </div>
            <div class="row mt-2">
                <div class="col-4 offset-4 text-center">
                    <h4><b><i>Please add your account information!</i></b></h4>
                </div>
            </div>
        }
        else
        {
            <div class="form-group row mt-2">
                <div class="col-3 text-center">
                    <label for="id">Account Id:</label>
                </div>
                <div class="col-9">
                    <InputText inert class="bg-dark text-light form-control" id="accountId" @bind-Value="@_accountInfo.AccountId" />
                </div>
            </div>

            <div class="form-group row">
                <div class="col-3 text-center">
                    <label for="first">First:</label>
                </div>
                <div class="col-9">
                    <InputText inert class="bg-dark text-light form-control " id="first" @bind-Value="@_accountInfo.FirstName" />
                </div>
            </div>
            <div class="form-group row">
                <div class="col-3 text-center">
                    <label for="last">Last:</label>
                </div>
                <div class="col-9">
                    <InputText inert class="bg-dark text-light form-control" id="last" @bind-Value="@_accountInfo.LastName" />
                </div>
            </div>

            <div class="form-group row">
                <div class="col-3 text-center">
                    <label for="email">Email:</label>
                </div>
                <div class="col-9">
                    <InputText inert class="bg-dark text-light form-control " id="email" @bind-Value="@_accountInfo.Email" />
                </div>
            </div>
            <div class="form-group row">
                <div class="col-3 text-center">
                    <label for="phone">Phone:</label>
                </div>
                <div class="col-9">
                    <InputText inert class="bg-dark text-light form-control" id="phone" @bind-Value="@_accountInfo.PhoneNumber" />
                </div>
            </div>
            <div class="form-group row">
                <div class="col-3 text-center">
                    <label for="status">Status:</label>
                </div>
                <div class="col-9">
                    <InputText inert class="bg-dark text-light form-control " id="status" @bind-Value="@_accountInfo.AccountStatus" />
                </div>
            </div>
            <div class="form-group row">
                <div class="col-3 text-center">
                    <label for="credit">Credit Limit:</label>
                </div>
                <div class="col-9">
                    <InputNumber inert class="bg-dark text-light form-control " id="credit" @bind-Value="@_accountInfo.CreditLimit" />
                </div>
            </div>

            <div class="row mt-4">
                <div class="col-10">
                    <h4>My Addresses</h4>
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-12">
                    @if (_accountInfo?.Addresses != null && _accountInfo.Addresses.Any())
                    {
                        <table class="table table-dark table-bordered text-center">
                            <thead>
                                <tr>
                                    <th>Street 1</th>
                                    <th>Street 2</th>
                                    <th>City</th>
                                    <th>State</th>
                                    <th>Zipcode</th>
                                    <th>Shipping</th>
                                    <th>Billing</th>

                                    <th colspan="3"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var address in _accountInfo.Addresses) 
                                {
                                    <tr>
                                        <td>@address.Street1</td>
                                        <td>@address.Street2</td>
                                        <td>@address.City</td>
                                        <td>@address.State</td>
                                        <td>@address.PostalCode</td>
                                        <td class="text-center">
                                            @if (address.IsPrimaryShipping)
                                            {
                                                <p class="text-success-alt m-0 p-0"><b>&#10004</b></p>
                                            }
                                        </td>

                                        <td class="text-center">
                                            @if (address.IsPrimaryBilling)
                                            {
                                                <p class="text-success-alt m-0 p-0"><b>&#10004</b></p>
                                            }
                                        </td>
                                        <td colspan="1">
                                            <span class="text-info-alt" style="cursor:pointer;">Detail</span>
                                        </td>
                                        <td colspan="1">
                                            <span class="text-success-alt" style="cursor:pointer;">Edit</span>
                                        </td>
                                        <td colspan="1">
                                            <span class="text-danger-alt" style="cursor:pointer;">Delete</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        @if (!_thinking)
                        {
                            <div class="row mt-2">
                                <div class="col-4 offset-4 text-center">
                                    <a class="btn button-custom-success-med form-control" @onclick="AddAddress">Add Address</a>
                                </div>
                            </div>
                        }
                    }

                </div>
            </div>
        }
    }

</div>

@if (_addAccountDTO is not null)
{
    <AddAccountModal AccountToAdd="@_addAccountDTO" Title="Add Account" Submit="SubmitAddAccount" Cancel="CancelAddAccount" />
}
@if (_addAddressDTO != null)
{
    <AddAddressModal Title="Add New Address" AddressToAdd="@_addAddressDTO" Cancel="CancelAddAddress" Submit="SubmitAddAddress" />
}

@code {

    private AccountDTO? _accountInfo;
    private bool _thinking = true;
    private string? _errorMessage;
    private void ClearErrorMessage() => _errorMessage = null;

    private AddAccountDTO? _addAccountDTO;
    private void AddAccount() => _addAccountDTO = new AddAccountDTO();
    private void CancelAddAccount() => _addAccountDTO = null;
    private async Task SubmitAddAccount()
    {
        _thinking = true;
        _errorMessage = null;
        if (_addAccountDTO is null)
        {
            _errorMessage = $"A new account object was not provided.";
            return;
        }
        else
        {
            var result = await _accountHttpService.CreateAccountAsync(_addAccountDTO!);
            if (result.IsSuccess) await ReloadAsync();
        }
        _addAccountDTO = null;
        _thinking = false;
    }

    private AddAddressDTO? _addAddressDTO;
    private void AddAddress() => _addAddressDTO = new AddAddressDTO();
    private void CancelAddAddress() => _addAddressDTO = null;
    private async Task SubmitAddAddress()
    {
        _thinking = true;
        if (_addAddressDTO is null)
        {
            _errorMessage = $"A new address object was not provided.";
            return;
        }
        else
        {
            var result = await _accountHttpService.AddAddressAsync(_addAddressDTO);
            _addAddressDTO = null;
            if (result.IsSuccess) await ReloadAsync();
        }
        _thinking = false;
    }

    private async Task ReloadAsync()
    {
        _thinking = true;
        var result = await _accountHttpService.GetAccountAsync();
        if (result.IsSuccess)
        {
            _accountInfo = result.Account;
        }
        else
        {
            _errorMessage = result.ErrorMessage;
        }
        _thinking = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ReloadAsync();
            this.StateHasChanged();
        }
    }
}
