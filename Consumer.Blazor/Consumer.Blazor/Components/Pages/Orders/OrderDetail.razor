<div class="row">
    <div class="col-10">
        <h3>Order Detail</h3>
    </div>
    <div class="col-2">
        <a class="btn button-custom-primary-med" @onclick="HandleBackToList">Back to List</a>
    </div>
</div>

<ErrorComponent SuccessMessage="@_successMessage" ErrorMessage="@_errorMessage" ClearSuccessCallback="ClearSuccessMessage" ClearErrorCallback="ClearErrorMessage" />

@if (OrderDTO is not null)
{
    <div class="row mt-4">
        <div class="col-5 offset-1">
            <h5><b>Order Date:</b> @OrderDTO.OrderDate.ToShortDateString()</h5>
            <h5><b>Status:</b> @OrderDTO.Status</h5>
            <h5><b>Billed To:</b> @OrderDTO.BillingAddress</h5>
        </div>
        <div class="col-6">
            <h5><b>Order Id:</b> @OrderDTO.OrderId</h5>
            <h5><b>Version:</b> @OrderDTO.Version</h5>
            <h5><b>Shipped To:</b> @OrderDTO.ShippingAddress</h5>
        </div>
    </div>
}

<div class="row mt-4">
    <div class="col-10">
        <h4>Order Items</h4>
    </div>
</div>
@if (OrderDTO?.Items is not null)
{
    <div class="row">
        <div class="col-12">
                <table class="table table-dark table-bordered">
                    <thead class="bg-success text-light">
                        <tr>
                            <th>Line Number</th>
                            <th>Product Id</th>
                            <th>Aggregate Id</th>
                            <th>Category</th>
                            <th>Product Name</th>
                            <th>Price Each</th>
                            <th>UOM</th>
                            <th>Quantity</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in OrderDTO.Items)
                        {
                            <tr>
                                <td>@item.LineNumber</td>
                                <td>@item.ProductId</td>
                                <td>@item.AggregateId?.Substring(0, 6)...</td>
                                <td>@item.Category</td>
                                <td>@item.Name</td>
                                <td>@item.Price</td>
                                <td>@item.UOM</td>
                                <td>@item.Quantity</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <br />
                <div class="row mt-2">
                    <div class="col-2">
                        <h5 class="text-primary"><b><i>Order Total: @_orderTotal</i></b></h5>
                    </div>
                </div>
        </div>
    </div>
}
else
{
    <div class="row">
        <div class="col-12">
            <h5 class="text-warning-alt"><i>No order items were found.</i></h5>
        </div>
    </div>
}

@code {

    [Parameter]
    public OrderDTO? OrderDTO { get; set; }
    [Parameter]
    public EventCallback BackToListCallback { get; set; }
    private void HandleBackToList() => BackToListCallback.InvokeAsync();

    private decimal _orderTotal = 0;

    // ERROR COMPONENT MESSAGING
    private string? _errorMessage;
    private string? _successMessage;
    private void ClearErrorMessage() => _errorMessage = null;
    private void ClearSuccessMessage() => _successMessage = null;
    private void ClearMessages()
    {
        _errorMessage = null;
        _successMessage = null;
    }
    private async Task HandleErrorMessage(string error) => _errorMessage = error;
    private async Task HandleSuccessMessage(string message) => _successMessage = message;

    // Calculate order total on first render
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            if (OrderDTO?.Items is not null)
            {
                foreach (var item in OrderDTO.Items)
                {
                    _orderTotal += item.Price * (decimal)item.Quantity;
                }
            }

            this.StateHasChanged();
        }
    }
}