@page "/orders/myOrders"
@rendermode InteractiveServer
@inject IOrdersHttpService _orderHttpService
@attribute [Authorize]

<h3>My Orders</h3>

@if (_thinking)
{
    <div class="mx-auto text-center mb-3 mt-3">
        <div class="spinner-border text-yellow-alt role-status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    @if (_selectedOrder is not null)
    {
        <OrderDetail OrderDTO="@_selectedOrder" BackToListCallback="HandleBackToListCallback" />
    }
    else
    {
        <ErrorComponent SuccessMessage="@_successMessage" ErrorMessage="@_errorMessage" ClearSuccessCallback="ClearSuccessMessage" ClearErrorCallback="ClearErrorMessage" />

        <div class="row">
            <div class="col-12">

                @if (_orders is not null && _orders.Any())
                {
                    <table class="table table-dark table-bordered text-center">
                        <thead class="bg-primary text-light">
                            <tr>
                                <th>Id</th>
                                <th>Order Id</th>
                                <th>Order Date</th>
                                <th>Status</th>
                                <th>Item Count</th>
                                <th>Version</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in _orders)
                            {
                                <tr>
                                    <td>@order.Id</td>
                                    <td>@order.OrderId</td>
                                    <td>@order.OrderDate.ToShortDateString()</td>
                                    <td>@order.Status</td>
                                    <td>@order.Items.Count</td>
                                    <td>@order.Version</td>
                                    <td>
                                        <a class="btn button-custom-table-primary" @onclick="() => Detail(order.Id!)">Detail</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <h5 class="text-center">No orders were found.</h5>
                }
            </div>
        </div>

        <div class="toolbar-paging">
            @if (_pagingData is not null)
            {
                <div class="row p-4">
                    <div class="col-8">
                        <ul class="pagination">
                            <li class="page-item">
                                <a class="btn button-custom-paging-arrow" role="button" @onclick="PageBackward">
                                    <i class="bi-chevron-double-left text-primary-alt"></i>
                                </a>
                            </li>
                            @for (int i = 1; i <= _pagingData.TotalPageCount; i++)
                            {
                                int page = i;
                                if (page == _pagingData.CurrentPage)
                                {
                                    <li class="page-item active">
                                        <a class="btn button-custom-paging-current" role="button" @onclick="(() => PageTo(page))">
                                            <span class="text-info-alt">@i</span>
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    <li class="page-item">
                                        <a class="btn button-custom-paging-page" role="button" @onclick="(() => PageTo(page))">
                                            <span class="text-primary-alt">@i</span>
                                        </a>
                                    </li>
                                }
                            }
                            <li class="page-item">
                                <a class="btn button-custom-paging-arrow" role="button" @onclick="PageForward">
                                    <i class="bi-chevron-double-right text-primary-alt"></i>
                                </a>
                            </li>
                        </ul>
                    </div>
                    <div class="col-4 ">
                        <div class="row ">
                            <div class="col-6 text-center ">
                                <span class="text-primary-alt"><i>Page Size: @_pagingData.PageSize</i></span>
                            </div>
                            <div class="col-6 text-center ">
                                <span class="text-primary-alt"><i>Item Count: @_pagingData.TotalItemCount</i></span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    private List<OrderDTO>? _orders;
    private PaginationMetadata? _pagingData;
    private OrderDTO? _selectedOrder;
    private void HandleBackToListCallback() => _selectedOrder = null;
    private bool _thinking = true;

    private string? _filter = null;
    private string? _sortColumn = "orderdate";
    private string? _sortOrder = "descending";
    private int _pageNumber = 1;
    private int _pageSize = 5;

    // ERROR COMPONENT MESSAGING
    private string? _errorMessage;
    private string? _successMessage;
    private void ClearErrorMessage() => _errorMessage = null;
    private void ClearSuccessMessage() => _successMessage = null;
    private void ClearMessages()
    {
        _errorMessage = null;
        _successMessage = null;
    }
    private async Task HandleErrorMessage(string error) => _errorMessage = error;
    private async Task HandleSuccessMessage(string message) => _successMessage = message;

    private async Task ClearFilters()
    {
        _filter = null;
        _sortColumn = "orderdate"; 
        _sortOrder = "descending";
        // _pageSize = 5;
        await RefreshData();
    }

    private async Task PageForward()
    {
        if (_pagingData is null || _pageNumber >= _pagingData.TotalPageCount) return;
        _pageNumber = _pageNumber + 1;
        await RefreshData();
    }

    private async Task PageBackward()
    {
        if (_pageNumber <= 1) return;
        _pageNumber = _pageNumber - 1;
        await RefreshData();
    }

    private async Task PageTo(int page)
    {
        if (page == _pagingData!.CurrentPage || page < 0 || page > _pagingData.TotalPageCount) return;
        _pageNumber = page;
        await RefreshData();
    }

    private void Detail(string id)
    {
        _selectedOrder = _orders?.FirstOrDefault(o => o.Id == id);
        if (_selectedOrder is null) _errorMessage = $"The order with id {id} could not be found.";
    }

    private async Task RefreshData()
    {
        _thinking = true;
        var result = await _orderHttpService.GetAllUserOrdersAsync(_filter, _sortColumn, _sortOrder, _pageNumber, _pageSize);
        if (result.IsSuccess)
        {
            _orders = result.OrderDTOs?.ToList();
            _pagingData = result.PagingData;
        }
        else _errorMessage = result.ErrorMessage;
        _thinking = false;
    }

    protected override async Task OnAfterRenderAsync(bool isFirstRender)
    {
        if (isFirstRender)
        {
            // var result = await _orderHttpService.GetAllUserOrdersAsync(_filter, _sortColumn, _sortOrder, _pageNumber, _pageSize);
            // if (result.IsSuccess)
            // {
            //     _orders = result.OrderDTOs?.ToList();
            //     _pagingData = result.PagingData;
            // }
            // else _errorMessage = result.ErrorMessage;

            // _thinking = false;

            await RefreshData();

            this.StateHasChanged();
        }
    }

}
