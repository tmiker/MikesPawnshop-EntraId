<div class="row mt-2">
    @if (ProductSummaries != null && ProductSummaries.Any())
    {

            @foreach (var product in ProductSummaries)
            {
                <div class="col-3">
                    <ProductCard Product="product" AddToCartCallback="() => AddToCart(product.AggregateId)" ProductDetailCallback="() => Detail(product.Id)" />
                </div>

            }
    }
</div>

@if (PagingData is not null)
{
    <div class="row p-4">
        <div class="col-8">
            <ul class="pagination">
                <li class="page-item">
                    <a class="btn button-custom-paging-arrow" role="button" @onclick="PageBackward">
                        <i class="bi-chevron-double-left text-primary-alt"></i>
                    </a>
                </li>
                @for (int i = 1; i <= PagingData.TotalPageCount; i++)
                {
                    int page = i;
                    if (page == PagingData.CurrentPage)
                    {
                        <li class="page-item active">
                            <a class="btn button-custom-paging-current" role="button" @onclick="(() => PageTo(page))">
                                <span class="text-info-alt">@i</span>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item">
                            <a class="btn button-custom-paging-page" role="button" @onclick="(() => PageTo(page))">
                                <span class="text-primary-alt">@i</span>
                            </a>
                        </li>
                    }
                }
                <li class="page-item">
                    <a class="btn button-custom-paging-arrow" role="button" @onclick="PageForward">
                        <i class="bi-chevron-double-right text-primary-alt"></i>
                    </a>
                </li>
            </ul>
        </div>
        <div class="col-4 ">
            <div class="row ">
                <div class="col-6 text-center ">
                    <span class="text-primary-alt"><i>Page Size: @PagingData.PageSize</i></span>
                </div>
                <div class="col-6 text-center ">
                    <span class="text-primary-alt"><i>Item Count: @PagingData.TotalItemCount</i></span>
                </div>
            </div>
        </div>
    </div>
}


@code {

    [CascadingParameter(Name = "Products")]
    public List<ProductSummaryDTO>? ProductSummaries { get; set; }
    [CascadingParameter(Name = "PagingData")]
    public PaginationMetadata? PagingData { get; set; }

    [Parameter]
    public EventCallback<string> ErrorMessageCallback { get; set; }
    private async Task ShowErrorMessage(string errorMessage)
    {
        if (ErrorMessageCallback.HasDelegate) await ErrorMessageCallback.InvokeAsync(errorMessage);
    }

    [Parameter]
    public EventCallback<string> SuccessMessageCallback { get; set; }
    private async Task ShowSuccessMessage(string successMessage)
    {
        if (SuccessMessageCallback.HasDelegate) await SuccessMessageCallback.InvokeAsync(successMessage);
    }

    // Dev Test Messaging from this component
    private async Task TestHandleError() => await ShowErrorMessage($"This is a test error message");
    private async Task TestHandleSuccess() => await ShowSuccessMessage($"This is a test success message");

    [Parameter]
    public EventCallback PageForwardCallback { get; set; }
    [Parameter]
    public EventCallback PageBackwardCallback { get; set; }
    [Parameter]
    public EventCallback<int> PageToCallback { get; set; }
    [Parameter]
    public EventCallback<int> DetailCallback { get; set; }
    [Parameter]
    public EventCallback<Guid> AddToCartCallback { get; set; }

    private async Task PageForward()
    {
        if (PageForwardCallback.HasDelegate) await PageForwardCallback.InvokeAsync();
    }

    private async Task PageBackward()
    {
        if (PageBackwardCallback.HasDelegate) await PageBackwardCallback.InvokeAsync();
    }

    private async Task PageTo(int page)
    {
        if (PageToCallback.HasDelegate) await PageToCallback.InvokeAsync(page);
    }

    private async Task Detail(int id)
    {
        if (DetailCallback.HasDelegate) await DetailCallback.InvokeAsync(id);
    }

    private async Task AddToCart(Guid productId)
    {
        if (AddToCartCallback.HasDelegate) await AddToCartCallback.InvokeAsync(productId);
    }

