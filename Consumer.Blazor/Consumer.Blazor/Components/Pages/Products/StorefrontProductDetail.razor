@page "/store/storefrontProductDetail"
@rendermode InteractiveServer
@inject IPublicProductsReadHttpService _readSideHttpClient

@if (_product is not null)
{
    <div class="row mt-1">
        <div class="col-6">
            <!-- COLUMN 1 START-->
            <div class="row">
                <div class="col-8">
                    <h4>Product Detail</h4>
                </div>
                <div class="col-4">
                    <a class="btn button-custom-primary form-control" @onclick="BackToList">Back</a>
                </div>
            </div>

            <br/>
            <div class="row mt-2">
                <div class="col-6">
                    @if (ProductFetchTime.HasValue)
                    {
                        <h6 class="text-secondary"><i>Data Fetched: @ProductFetchTime.Value</i></h6>
                    }
                </div>
                <div class="col-6">
                    <h6 class="text-secondary"><i>Current Time: @DateTime.Now</i></h6>
                </div>
            </div>

            <div class="form-group row mt-2">
                <div class="col-3 ">
                    <label for="id">Id:</label>
                </div>
                <div class="col-9">
                    <InputNumber inert class="bg-dark text-light form-control" id="id" @bind-Value="@_product.Id" />
                </div>
            </div>
            <div class="form-group row">
                <div class="col-3 ">
                    <label for="aggId">Aggregate Id:</label>
                </div>
                <div class="col-9">
                    <InputText inert class="bg-dark text-light form-control" id="aggId" @bind-Value="@_productAggregateId" />
                </div>
            </div>
            <div class="form-group row">
                <div class="col-3 ">
                    <label for="name">Name:</label>
                </div>
                <div class="col-9">
                    <InputText inert class="bg-dark text-light form-control " id="name" @bind-Value="@_product.Name" />
                </div>
            </div>
            <div class="form-group row">
                <div class="col-3 ">
                    <label for="category">Category:</label>
                </div>
                <div class="col-9">
                    <InputText inert class="bg-dark text-light form-control " id="category" @bind-Value="@_product.Category" />
                </div>
            </div>
            <div class="form-group row">
                <div class="col-3 ">
                    <label for="description">Description:</label>
                </div>
                <div class="col-9">
                    <InputTextArea inert class="bg-dark text-light form-control" id="description" @bind-Value="@_product.Description" />
                </div>
            </div>

            <div class="form-group row mt-4">
                <div class="col-5">
                    <div class="form-group row">
                        <div class="col-5 ">
                            <label for="price">Price:</label>
                        </div>
                        <div class="col-7">
                            <InputNumber inert class="bg-dark text-light form-control " id="price" @bind-Value="@_product.Price" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-5 ">
                            <label for="status">Status:</label>
                        </div>
                        <div class="col-7">
                            <InputText inert class="bg-dark text-light form-control" id="status" @bind-Value="@_product.Status" />
                        </div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="form-group row">
                        <div class="col-5 ">
                            <label for="currency">Currency:</label>
                        </div>
                        <div class="col-7">
                            <InputText inert class="bg-dark text-light form-control " id="currency" @bind-Value="@_product.Currency" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-5 ">
                            <label for="version">Version:</label>
                        </div>
                        <div class="col-7">
                            <InputNumber inert class="bg-dark text-light form-control" id="version" @bind-Value="@_product.Version" />
                        </div>
                    </div>
                </div>
                <div class="col-3">
                    <div class="form-group row">
                        <div class="col-5">
                            <label for="uom">UOM:</label>
                        </div>
                        <div class="col-7">
                            <InputText inert class="bg-dark text-light form-control " id="uom" @bind-Value="_product.UOM" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-5">
                            <label for="lowstock">LST:</label>
                        </div>
                        <div class="col-7">
                            <InputNumber inert class="bg-dark text-light form-control " id="lowstock" @bind-Value="_product.LowStockThreshold" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-group row">
                <div class="col-5">
                    <div class="form-group row">
                        <div class="col-5">
                            <label for="qoh">On Hand:</label>
                        </div>
                        <div class="col-7">
                            <InputNumber inert class="bg-dark text-light form-control " id="qoh" @bind-Value="_product.QuantityOnHand" />
                        </div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="form-group row">
                        <div class="col-5">
                            <label for="qalloc">Allocated:</label>
                        </div>
                        <div class="col-7">
                            <InputNumber inert class="bg-dark text-light form-control " id="qalloc" @bind-Value="_product.QuantityAllocated" />
                        </div>
                    </div>
                </div>
                <div class="col-3">
                    <p class="mt-2"><i>(@_product.QuantityAvailable available)</i></p>
                    @* <div class="form-group row">
                        <div class="col-5">
                            <label for="lowstock">LST:</label>
                        </div>
                        <div class="col-7">
                            <InputNumber inert class="bg-dark text-light form-control " id="lowstock" @bind-Value="_product.LowStockThreshold" />
                        </div>
                    </div> *@
                </div>
            </div>

            <!-- COLUMN 1 END -->
            <AuthorizeView>
                <Authorized>
                    <hr />
                    <div class="row">
                        <div class="col-4">
                            <label>Quantity to Add:</label>
                            <input type="number" class="form-control bg-dark text-light form-control" @bind-value="@_quantityToAdd" />
                        </div>
                        <div class="col-4">
                            <a class="btn button-custom-success mt-3" @onclick="() => AddToCart(_quantityToAdd)">Add to Cart</a>
                        </div>
                        <div class="col-4 text-center">
                            @* <label>Quantity Available:</label>
                            <p class="mt-2">@_product.QuantityAvailable</p> *@
                            @* <p class="mt-4"><i>(@_product.QuantityAvailable available)</i></p> *@
                        </div>
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>
        <div class="col-5 offset-1 text-center">
            <!-- COLUMN 2 START -->

            <div class="row ">
                @if (_showDocuments)
                {
                    <div class="col-5">
                        <a class="btn button-custom-primary form-control" @onclick="ToogleShowDocuments">Show Images</a>
                    </div>
                }
                else
                {
                    <div class="col-5">
                        <a class="btn button-custom-primary form-control" @onclick="ToogleShowDocuments">Show Documents</a>
                    </div>
                }
            </div>

            <hr />

            @if (_showDocuments)
            {
                if (_product.Documents is not null && _product.Documents.Any())
                {
                    <div class="row mt-2">
                        <div class="col-12 text-center ">
                            <h5><b>Documents</b></h5>
                        </div>
                    </div>

                    <table class="table table-dark table-bordered mt-2">
                        <thead>
                            <tr>
                                <th>Seq. No.</th>
                                <th>File Name</th>
                                <th>Title</th>
                                <th></th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var doc in _product.Documents)
                            {
                                <tr>
                                    <td>@doc.SequenceNumber</td>
                                    <td>@doc.Name</td>
                                    <td>@doc.Title</td>
                                    <td>
                                        <a class="btn button-custom-table-primary" href="@doc.DocumentUrl" target="_blank">View</a>
                                    </td>
                                    @* <td>
                                        <a class="btn button-custom-table-danger">Delete</a>
                                    </td> *@
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <h5 class="text-info mt-2"><i>There are currently no product documents.</i></h5>
                }
            }
            else
            {
                // show images
                if (_product.Images is not null && _product.Images.Any())
                {
                    <div class="row mt-2">
                        <div class="col-12 text-center ">
                            <h5><b>Images</b></h5>
                        </div>
                    </div>
                    @if (_primaryImage != null)
                    {
                        <div class="row">
                            <div class="col-12 text-center">
                                <img src="@_primaryImage.ImageUrl" width="400" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12 text-center">
                                <p class="text-primary"><i>@_primaryImage.Caption</i></p>
                            </div>
                        </div>
                    }
                    <div class="row">
                        @if (_primaryImage != null)
                        {
                            <div class="col-1 text-center ">
                                <span><i>@_primaryImage.SequenceNumber</i></span>
                            </div>
                            <div class="col-6 offset-2 text-center">
                                <span><i>@_primaryImage.Name</i></span>
                            </div>

                        }
                    </div>
                }
                else
                {
                    <h5 class="text-info mt-2"><i>There are currently no product images.</i></h5>
                }

                <br />

                <div class="row">
                    @if (_product.Images != null && _product.Images.Any())
                    {
                        @foreach (var image in _product.Images)
                        {
                            <div class="col-2 mx-2">
                                @if (image.SequenceNumber == _primaryImage?.SequenceNumber)
                                {
                                    <img src="@image.ThumbnailUrl" width="100" style="border:2px solid blue;" />
                                }
                                else
                                {
                                    <img src="@image.ThumbnailUrl" width="100" style="cursor:pointer;" @onclick="(() => SetPrimaryImage(image.SequenceNumber))" />
                                }
                            </div>
                        }
                    }
                </div>
            }
            <!-- COLUMN 2 END -->
        </div>
    </div>
}

@code {

    [CascadingParameter(Name = "SelectedProductId")]
    public int SelectedProductId { get; set; }

    [Parameter]
    public EventCallback<int> AddToCartWithQuantityCallback { get; set; }
    private async Task AddToCart(int quantityToAdd)
    {
        if (AddToCartWithQuantityCallback.HasDelegate) await AddToCartWithQuantityCallback.InvokeAsync(_quantityToAdd);
    }

    [Parameter]
    public EventCallback BackToListCallback { get; set; }
    private async Task BackToList()
    {
        if (BackToListCallback.HasDelegate) await BackToListCallback.InvokeAsync();
    }

    [Parameter]
    public EventCallback<string> ErrorMessageCallback { get; set; }
    private async Task ShowErrorMessage(string errorMessage)
    {
        if (ErrorMessageCallback.HasDelegate) await ErrorMessageCallback.InvokeAsync(errorMessage);
    }

    [Parameter]
    public EventCallback<string> SuccessMessageCallback { get; set; }
    private async Task ShowSuccessMessage(string successMessage)
    {
        if (SuccessMessageCallback.HasDelegate) await SuccessMessageCallback.InvokeAsync(successMessage);
    }

    // Dev Test Messaging from this component
    private async Task TestHandleError() => await ShowErrorMessage($"This is a test error message");
    private async Task TestHandleSuccess() => await ShowSuccessMessage($"This is a test success message");

    public DateTime? ProductFetchTime { get; set; }

    private int _quantityToAdd = 1;

    private ProductDTO? _product;
    private string? _productAggregateId;

    private ImageDataDTO? _primaryImage { get; set; }

    private bool _showDocuments = false;
    private void ToogleShowDocuments() => _showDocuments = !_showDocuments;

    private void SetPrimaryImage(int sequenceNumber)
    {
        var primaryImage = _product!.Images?.FirstOrDefault(i => i.SequenceNumber == sequenceNumber);
        if (primaryImage != null)
        {
            _primaryImage = primaryImage;
        }
    }

    protected override async Task OnAfterRenderAsync(bool isFirstRender)
    {
        if (isFirstRender)
        {
            Console.WriteLine($"@@@@@@@@@@ **************** StorefrontProductDetail.razor OnAfterRender was called. *************** @@@@@@@@@");
            var result = await _readSideHttpClient.GetProductByIdAsync(SelectedProductId);
            if (result.IsSuccess) 
            {
                _product = result.Product;
                _productAggregateId = _product?.AggregateId.ToString();
                if (_product?.Images is not null && _product.Images.Any()) _primaryImage = _product.Images.FirstOrDefault();
                ProductFetchTime = result.Product?.FetchTime;
            }
            else await ShowErrorMessage(result.ErrorMessage ?? "An unspecified error occurred.");
            this.StateHasChanged();
        }
    }
}
