@rendermode InteractiveServer
@inject NavigationManager _nav
@inject ICartsHttpService _cartService
@inject IOrderMapper _orderMapper
@attribute [Authorize]

<div class="row mt-2 mb-4">
    <div class="col-4">
    </div>
    @if (_addOrderDTO is null)
    {
        <div class="col-4">
            <h5 class="text-center mt-2"><b>My Cart</b></h5>
        </div>
        <div class="col-2 offset-2">
            <a class="btn button-custom-warning form-control" @onclick="Checkout"><i class="bi-lightning-charge"></i> &nbsp; Checkout</a>
        </div>
    }
    else
    {
        <div class="col-4">
            <h5 class="text-center mt-2"><b>Checkout</b></h5>
        </div>
        <div class="col-2 offset-2">
            <a class="btn button-custom-warning form-control" @onclick="BackToCart"><i class="bi-cart2"></i> &nbsp; Back to Cart</a>
        </div>
    }
</div>

@if (_addOrderDTO is not null)
{
    <StorefrontCheckoutView AddOrderDTO="@_addOrderDTO" OrderSubmittedCallback="OrderSubmitted" ErrorMessageCallback="HandleComponentError" SuccessMessageCallback="HandleComponentSuccess" />
}
else
{
    <div class="row mt-2">
        <div class="col-12">
            @if (MyCart?.Items != null)
            {
                <table class="table table-dark table-bordered">
                    <thead class="bg-success text-light">
                        <tr>
                            <th>Line Number</th>
                            <th>Product Id</th>
                            <th>Aggregate Id</th>
                            <th>Category</th>
                            <th>Product Name</th>
                            <th>Price Each</th>
                            <th>UOM</th>
                            <th>Quantity</th>
                            <th>Thumb URL</th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in MyCart.Items)
                        {
                            <tr>
                                <td>@item.LineNumber</td>
                                <td>@item.ProductId</td>
                                <td>@item.AggregateId?.Substring(0, 6)...</td>
                                <td>@item.Category</td>
                                <td>@item.Name</td>
                                <td>@item.Price</td>
                                <td>@item.UOM</td>
                                <td>@item.Quantity</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.ThumbnailUrl))
                                    {
                                        <img src="@item.ThumbnailUrl" alt="thumbnail" width="100" />
                                    }
                                    else
                                    {
                                        <p>pending</p>
                                    }
                                </td>
                                <td>
                                    <a class="btn btn-primary form-control" @onclick="() => Detail(item.ProductId!)"><b><i class="bi-list"></i>&nbsp; Detail</b></a>
                                </td>
                                <td>
                                    <a class="btn btn-success form-control" @onclick="() => IncrementAsync(item.AggregateId!)"><b>+</b></a>
                                </td>
                                <td>
                                    <a class="btn btn-danger form-control" @onclick="() => DecrementAsync(item.AggregateId!)"><b>-</b></a>
                                </td>
                                <td>
                                    <a class="btn btn-danger form-control" @onclick="() => RemoveItemAsync(item.AggregateId!)"><b><i class="bi-trash"></i>&nbsp; Remove</b></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <br />
                <div class="row mt-2">
                    <div class="col-2">
                        <h5 class="text-primary"><b><i>Cart Total: @MyCart?.TotalAmount</i></b></h5>
                    </div>
                </div>
            }
            else
            {
                <div class="row">
                    <div class="col-12">
                        <h5 class="text-warning-alt"><i>No cart items were found.</i></h5>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    [CascadingParameter(Name = "ShoppingCart")]
    public ShoppingCartDTO? MyCart { get; set; }

    [Parameter]
    public EventCallback<int> DetailCallback { get; set; }
    private async Task Detail(int id)
    {
        if (DetailCallback.HasDelegate) await DetailCallback.InvokeAsync(id);
    }

    [Parameter]
    public EventCallback<int> CartItemCountChangedCallback { get; set; }
    private async Task CartItemCountChanged(int count)
    {
        if (CartItemCountChangedCallback.HasDelegate) await CartItemCountChangedCallback.InvokeAsync(count);
    }

    [Parameter]
    public EventCallback OrderSubmittedCallback { get; set; }
    private async Task OrderSubmitted()
    {
        if (OrderSubmittedCallback.HasDelegate) await OrderSubmittedCallback.InvokeAsync();
    }

    [Parameter]
    public EventCallback<string> ErrorMessageCallback { get; set; }
    private async Task ShowErrorMessage(string errorMessage)
    {
        if (ErrorMessageCallback.HasDelegate) await ErrorMessageCallback.InvokeAsync(errorMessage);
    }

    [Parameter]
    public EventCallback<string> SuccessMessageCallback { get; set; }
    private async Task ShowSuccessMessage(string successMessage)
    {
        if (SuccessMessageCallback.HasDelegate) await SuccessMessageCallback.InvokeAsync(successMessage);
    }

    // Handlers for StorefrontCheckoutView Child Component Message Parameters
    private async Task HandleComponentError(string message) => await ShowErrorMessage(message);
    private async Task HandleComponentSuccess(string message) => await ShowSuccessMessage(message);

    private AddOrderDTO? _addOrderDTO;

    private void Checkout()
    {
        if (MyCart is not null) _addOrderDTO = _orderMapper.MapCartToAddOrderDTO(MyCart);
    }

    private void BackToCart() => _addOrderDTO = null;

    private async Task IncrementAsync(string aggregateId)
    {
        var result = await _cartService.UpdateProductQuantityAsync(aggregateId, 1);
        if (result.IsSuccess)
        {
            var item = MyCart!.Items?.FirstOrDefault(i => i.AggregateId == aggregateId);
            if (item is not null) item.Quantity += 1.0;
        }
    }

    private async Task DecrementAsync(string aggregateId)
    {
        var result = await _cartService.UpdateProductQuantityAsync(aggregateId, -1);
        if (result.IsSuccess)
        {
            var item = MyCart!.Items?.FirstOrDefault(i => i.AggregateId == aggregateId);
            if (item is not null)
            {
                item.Quantity -= 1.0;
                if (item.Quantity <= 0)
                {
                    MyCart.Items!.Remove(item);
                    if (CartItemCountChangedCallback.HasDelegate) await CartItemCountChangedCallback.InvokeAsync(MyCart.Items.Count);
                }
            }
        }
    }

    private async Task RemoveItemAsync(string aggregateId)
    {
        var result = await _cartService.RemoveCartItemAsync(aggregateId);
        if (result.IsSuccess)
        {
            var item = MyCart!.Items?.FirstOrDefault(i => i.AggregateId == aggregateId);
            if (item is not null)
            {
                MyCart.Items!.Remove(item);
                if (CartItemCountChangedCallback.HasDelegate) await CartItemCountChangedCallback.InvokeAsync(MyCart.Items.Count);
            }
        }
    }
}